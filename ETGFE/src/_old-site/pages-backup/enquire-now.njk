{% include "src/widgets/new-header/new-header.njk" %}
{% endblock %}

{% block article %}
{% include "src/widgets/breadcrumbs/breadcrumbs.njk" %}
{% include "src/widgets/new-package-hero/new-package-hero--single-image.njk" %}
<div class="wrapper wp">
  <div class="article-layout">
    <div class="main">
      {% include "src/widgets/package-detail-title/package-detail-title.njk" %}
      {% include "src/widgets/package-detail-bar/package-detail-bar.njk" %}
      {% include "src/widgets/package-intro/package-intro.njk" %}
      {% include "src/widgets/enquire-form/enquire-form.njk" %}
    </div>
    <div class="side">
      {% include "src/widgets/peace-booking-plan/peace-booking-plan.njk" %}
