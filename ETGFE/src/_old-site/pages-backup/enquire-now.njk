  </div>
</div>
{% include "src/widgets/experience-ticker/experience-ticker.njk" %}
{% endblock %}

{% block afterArticle %}
{% include "src/widgets/new-footer/new-footer.njk" %}
{% endblock %}

{% block scripts %}
<script src="scripts/enquire-now.js"></script>
{% endblock %}
