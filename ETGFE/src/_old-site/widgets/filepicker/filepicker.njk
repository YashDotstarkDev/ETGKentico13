<div class="widget filepicker">
  <div class="field">
{#    <label for="files">CV Upload</label>#}
    <div class="file-picker">
      <div class="trigger">
        <button type="button" class="ui primary button">Attach CV</button>
{#        <div class="file-count"></div>#}
      </div>
      <input type="file" id="files" name="files" data-rules="empty" data-prompts="Please choose a file" multiple accept=".jpg, .png, .doc, .pdf, .docx">
      <div class="file-list"></div>
      <input type="hidden" data-rules="empty" data-prompts="Please choose a file" name="file-json" class="file-json">
    </div>
  </div>
</div>
