<div class="widget pay-now">
  <div class="top">
    <div class="wrapper">
      <h1>Payments</h1>
    </div>
  </div>
  <div class="bottom wp">
    <div class="wrapper">
      <h3>To pay by credit card, please complete the form below.</h3>

      <div class="article-layout">
        <div class="main">

          <div class="payment-form">

            <div class="form-heading">
              <h4>Your details</h4>
              <div class="cards">
                <img src="/images/cards-new.png">
              </div>
            </div>

            <div class="ui form generic-form" data-method="GET" data-endpoint="api/book-now-api/createorder.json" data-validate-inline="data-validate-inline" data-validate-on="submit">
              <div class="row">
                <div class="column">
                  <div class="field">
                    <label>Lead passenger - First name</label>
                    <input type="text" name="firstname" data-rules="regExp[/[aeiou]/]" data-prompts="Please enter a valid first name" tabindex="1"/>
                  </div>

                  <div class="field">
                    <label>Lead passenger - Last name</label>
                    <input type="text" name="lastname" data-rules="regExp[/[aeiou]/]" data-prompts="Please enter a valid last name" tabindex="2"/>
                  </div>

                  <div class="field">
                    <label class="with-tooltip">
                      <div>Contact number</div>
                      <div class="ui tool-tip" data-html="<b>Australian Number</b><br><i>Area Code + Number</i><br>e.g. 0290943322<br><br><b>Australian Mobile</b><br><i>10 digits no spaces</i><br>e.g. 0430123123<br><br><b>International Number</b><br><i>Country Code + area code + number</i><br>e.g. +33148643543">
                        <svg width="14" height="15" viewBox="0 0 14 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M7 0.96875C3.25391 0.96875 0.21875 4.03125 0.21875 7.75C0.21875 11.4961 3.25391 14.5312 7 14.5312C10.7188 14.5312 13.7812 11.4961 13.7812 7.75C13.7812 4.03125 10.7188 0.96875 7 0.96875ZM7 13.2188C3.96484 13.2188 1.53125 10.7852 1.53125 7.75C1.53125 4.74219 3.96484 2.28125 7 2.28125C10.0078 2.28125 12.4688 4.74219 12.4688 7.75C12.4688 10.7852 10.0078 13.2188 7 13.2188ZM7 3.97656C6.34375 3.97656 5.85156 4.49609 5.85156 5.125C5.85156 5.78125 6.34375 6.27344 7 6.27344C7.62891 6.27344 8.14844 5.78125 8.14844 5.125C8.14844 4.49609 7.62891 3.97656 7 3.97656ZM8.53125 10.9219V10.2656C8.53125 10.1016 8.36719 9.9375 8.20312 9.9375H7.875V7.20312C7.875 7.03906 7.71094 6.875 7.54688 6.875H5.79688C5.60547 6.875 5.46875 7.03906 5.46875 7.20312V7.85938C5.46875 8.05078 5.60547 8.1875 5.79688 8.1875H6.125V9.9375H5.79688C5.60547 9.9375 5.46875 10.1016 5.46875 10.2656V10.9219C5.46875 11.1133 5.60547 11.25 5.79688 11.25H8.20312C8.36719 11.25 8.53125 11.1133 8.53125 10.9219Z" fill="#333333"/>
                        </svg>
                      </div>
                    </label>
                    <input type="text" name="phone" data-rules="phone" data-prompts="" tabindex="3"/>
                  </div>
                </div>
                <div class="column">
                  <div class="field">
                    <label>Email</label>
                    <input type="text" name="email" data-rules="empty,email" data-prompts="" tabindex="4" />
                  </div>
                  <div class="field">
                    <label class="with-tooltip">
                      <div>Invoice Booking Reference</div>
                      <div class="ui tool-tip" data-html="Use the full alpha-numeric Booking Reference shown on your invoice.<br><br>eg. <b>ETG123456</b>">
                        <svg width="14" height="15" viewBox="0 0 14 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M7 0.96875C3.25391 0.96875 0.21875 4.03125 0.21875 7.75C0.21875 11.4961 3.25391 14.5312 7 14.5312C10.7188 14.5312 13.7812 11.4961 13.7812 7.75C13.7812 4.03125 10.7188 0.96875 7 0.96875ZM7 13.2188C3.96484 13.2188 1.53125 10.7852 1.53125 7.75C1.53125 4.74219 3.96484 2.28125 7 2.28125C10.0078 2.28125 12.4688 4.74219 12.4688 7.75C12.4688 10.7852 10.0078 13.2188 7 13.2188ZM7 3.97656C6.34375 3.97656 5.85156 4.49609 5.85156 5.125C5.85156 5.78125 6.34375 6.27344 7 6.27344C7.62891 6.27344 8.14844 5.78125 8.14844 5.125C8.14844 4.49609 7.62891 3.97656 7 3.97656ZM8.53125 10.9219V10.2656C8.53125 10.1016 8.36719 9.9375 8.20312 9.9375H7.875V7.20312C7.875 7.03906 7.71094 6.875 7.54688 6.875H5.79688C5.60547 6.875 5.46875 7.03906 5.46875 7.20312V7.85938C5.46875 8.05078 5.60547 8.1875 5.79688 8.1875H6.125V9.9375H5.79688C5.60547 9.9375 5.46875 10.1016 5.46875 10.2656V10.9219C5.46875 11.1133 5.60547 11.25 5.79688 11.25H8.20312C8.36719 11.25 8.53125 11.1133 8.53125 10.9219Z" fill="#333333"/>
                        </svg>
                      </div>
                    </label>
                    <input type="text" name="InvoiceBookingReference" data-rules="empty" data-prompts="" tabindex="5"/>
                  </div>
                  <div class="field">
                    <label>Payment Amount</label>
                    <div class="payment-input">
                      <input type="text" name="paymentAmount" data-rules="empty" data-prompts="" tabindex="6"/>
                    </div>
                  </div>
                </div>
              </div>

              <div class="row right">
                <div class="field">
                  <div class="ui checkbox">
                    <input type="checkbox" name="acceptterms" value="acceptterms" data-rules="checkboxCount[1]"  data-prompts="Please accept Terms and Conditions" />
                    <label>
                      I accept the <a href="#" target="_blank">
                        Terms and Conditions
