                          <path d="M10.125 8H9.375C9.16406 8 9 8.1875 9 8.375V11H1.5V3.5H4.875C5.0625 3.5 5.25 3.33594 5.25 3.125V2.375C5.25 2.1875 5.0625 2 4.875 2H1.125C0.492188 2 0 2.51562 0 3.125V11.375C0 12.0078 0.492188 12.5 1.125 12.5H9.375C9.98438 12.5 10.5 12.0078 10.5 11.375V8.375C10.5 8.1875 10.3125 8 10.125 8ZM11.1094 0.5H7.40625C7.03125 0.5 6.75 0.804688 6.75 1.15625V1.60156C6.75 1.95312 7.03125 2.23438 7.38281 2.23438C7.40625 2.23438 7.40625 2.23438 7.40625 2.23438L9 2.1875L3.16406 8C3.04688 8.09375 2.97656 8.23438 2.97656 8.39844C2.97656 8.53906 3.04688 8.67969 3.16406 8.79688L3.70312 9.33594H3.72656C3.82031 9.45312 3.96094 9.5 4.10156 9.5C4.26562 9.5 4.40625 9.45312 4.5 9.33594L10.3125 3.5L10.2656 5.09375C10.2656 5.46875 10.5469 5.75 10.9219 5.75H11.3438C11.6953 5.75 12 5.46875 12 5.09375V1.39062C12 0.898438 11.6016 0.5 11.1094 0.5Z" fill="#CA568E"/>
                        </svg>
                      </a> and
                      <a href="#" target="_blank">
                        Payment Conditions
                        <svg width="12" height="13" viewBox="0 0 12 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M10.125 8H9.375C9.16406 8 9 8.1875 9 8.375V11H1.5V3.5H4.875C5.0625 3.5 5.25 3.33594 5.25 3.125V2.375C5.25 2.1875 5.0625 2 4.875 2H1.125C0.492188 2 0 2.51562 0 3.125V11.375C0 12.0078 0.492188 12.5 1.125 12.5H9.375C9.98438 12.5 10.5 12.0078 10.5 11.375V8.375C10.5 8.1875 10.3125 8 10.125 8ZM11.1094 0.5H7.40625C7.03125 0.5 6.75 0.804688 6.75 1.15625V1.60156C6.75 1.95312 7.03125 2.23438 7.38281 2.23438C7.40625 2.23438 7.40625 2.23438 7.40625 2.23438L9 2.1875L3.16406 8C3.04688 8.09375 2.97656 8.23438 2.97656 8.39844C2.97656 8.53906 3.04688 8.67969 3.16406 8.79688L3.70312 9.33594H3.72656C3.82031 9.45312 3.96094 9.5 4.10156 9.5C4.26562 9.5 4.40625 9.45312 4.5 9.33594L10.3125 3.5L10.2656 5.09375C10.2656 5.46875 10.5469 5.75 10.9219 5.75H11.3438C11.6953 5.75 12 5.46875 12 5.09375V1.39062C12 0.898438 11.6016 0.5 11.1094 0.5Z" fill="#CA568E"/>
                        </svg>
                      </a>
                    </label>
                  </div>
                </div>
              </div>

              <div class="row right">
                <div class="field">
                  <button class="ui button submit primary">Pay Now</button>
                </div>
              </div>

            </div>
          </div>
          {% include "src/widgets/faqs/faqs.njk" %}

        </div>
        <div class="side">
          <div class="other-options">
            <h4>Other payment options</h4>
            <div class="payment-option">
              <div class="heading">Direct Deposit</div>
              <div class="content">
                Entire Travel Group Pty Ltd<br>
                BSB - 082-401<br>
                A/C - 71-846-1340
              </div>
            </div>
            <div class="payment-option">
              <div class="heading">TravelPay B2B</div>
              <div class="content">
