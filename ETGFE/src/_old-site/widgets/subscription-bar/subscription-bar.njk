        <div class="label">Get deals, travel articles, and holiday inspiration</div>

        <div class="field full">
          <input type="email" name="email" data-rules="empty,email" data-prompts="Please enter valid email" placeholder="Email address"/>
        </div>

        <div class="field">
          <div class="ui checkbox">
            <input type="checkbox" name="example">
            <label>Are you a travel agent?</label>
          </div>
        </div>

        <button class="ui transparent  submit button" type="button">Subscribe</button>
      </div>
    </div>
  </div>
</div>
