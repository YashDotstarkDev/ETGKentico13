---
import CampaignStickyHeaderController from './CampaignStickyHeaderController.vue';
---
<CampaignStickyHeaderController client:only="vue">
    <div class="campaign-sticky-header fixed top-[100px] inset-x-0 h-[60px] z-[500]">
        <div class="inner-container -translate-y-[110%] transition-all duration-300 [.scrolled_&]:translate-y-0 bg-[#ededed]">

            <div class="md:absolute md:inset-0 z-10 h-[30px] md:h-[60px] flex items-center">
                <div class="swiper isolate text-left text-sm font-semibold relative z-10">
                    <div class="swiper-wrapper !ease-linear">
                        <!-- repeat the same slide a few times to fill the space -->
                        <div class="swiper-slide !w-auto">
                            <ul class="whitespace-nowrap flex items-center">
                                <li class="px-4 border-l border-black/10 py-1">Save up to AUD600 per couple</li>
                                <li class="px-4 border-l border-black/10 py-1">Book by 30 May 2025</li>
                                <li class="px-4 border-l border-black/10 py-1">Vancouver discover more</li>
                            </ul>
                        </div>
                        <div class="swiper-slide !w-auto">
                            <ul class="whitespace-nowrap flex items-center">
                                <li class="px-4 border-l border-black/10 py-1">Save up to AUD600 per couple</li>
                                <li class="px-4 border-l border-black/10 py-1">Book by 30 May 2025</li>
                                <li class="px-4 border-l border-black/10 py-1">Vancouver discover more</li>
                            </ul>
                        </div>
                        <div class="swiper-slide !w-auto">
                            <ul class="whitespace-nowrap flex items-center">
                                <li class="px-4 border-l border-black/10 py-1">Save up to AUD600 per couple</li>
                                <li class="px-4 border-l border-black/10 py-1">Book by 30 May 2025</li>
                                <li class="px-4 border-l border-black/10 py-1">Vancouver discover more</li>
                            </ul>
                        </div>
                        <div class="swiper-slide !w-auto">
                            <ul class="whitespace-nowrap flex items-center">
                                <li class="px-4 border-l border-black/10 py-1">Save up to AUD600 per couple</li>
                                <li class="px-4 border-l border-black/10 py-1">Book by 30 May 2025</li>
                                <li class="px-4 border-l border-black/10 py-1">Vancouver discover more</li>
                            </ul>
                        </div>
                        <div class="swiper-slide !w-auto">
                            <ul class="whitespace-nowrap flex items-center">
                                <li class="px-4 border-l border-black/10 py-1">Save up to AUD600 per couple</li>
                                <li class="px-4 border-l border-black/10 py-1">Book by 30 May 2025</li>
                                <li class="px-4 border-l border-black/10 py-1">Vancouver discover more</li>
                            </ul>
                        </div>
                        <div class="swiper-slide !w-auto">
                            <ul class="whitespace-nowrap flex items-center">
                                <li class="px-4 border-l border-black/10 py-1">Save up to AUD600 per couple</li>
                                <li class="px-4 border-l border-black/10 py-1">Book by 30 May 2025</li>
                                <li class="px-4 border-l border-black/10 py-1">Vancouver discover more</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="wrapper relative z-20">
                <div class="flex md:justify-end">
                    <div class="counter-container relative z-10 flex items-center justify-center bg-[#333] md:p-6 w-full md:w-auto h-[30px] md:h-[60px]">
                        <div class="counter-label uppercase text-white text-[12px] font-bold relative z-10">Time Remaining</div>
                        <div class="timer js-discounts-offers-timer flex items-end relative z-10" data-end="8 July 2025 15:45:00 GMT+10:00">
                            <div class="timer-unit text-center relative min-w-[30px] px-1 md:min-w-[40px]">
                                <div class="text-primary text-[14px] md:text-[18px] font-black" data-timer-unit="days"></div>
                                <div class="label hidden md:block text-[10px] text-white uppercase absolute -bottom-3 opacity-50 inset-x-0 text-center">Days</div>
                            </div>
                            <div class="divider text-white text-[14px] md:text-[18px] font-black">:</div>
                            <div class="timer-unit text-center relative min-w-[30px] px-1 md:min-w-[40px]">
                                <div class="text-primary text-[14px] md:text-[18px] font-black" data-timer-unit="hours"></div>
                                <div class="label hidden md:block text-[10px] text-white uppercase absolute -bottom-3 opacity-50 inset-x-0 text-center">Hours</div>
                            </div>
                            <div class="divider text-white text-[14px] md:text-[18px] font-black">:</div>
                            <div class="timer-unit text-center relative min-w-[30px] px-1 md:min-w-[40px]">
                                <div class="text-primary text-[14px] md:text-[18px] font-black" data-timer-unit="minutes"></div>
                                <div class="label hidden md:block text-[10px] text-white uppercase absolute -bottom-3 opacity-50 inset-x-0 text-center">Mins</div>
                            </div>
                            <div class="divider text-white text-[14px] md:text-[18px] font-black">:</div>
                            <div class="timer-unit text-center relative min-w-[30px] px-1 md:min-w-[40px]">
                                <div class="text-primary text-[14px] md:text-[18px] font-black" data-timer-unit="seconds"></div>
                                <div class="label hidden md:block text-[10px] text-white uppercase absolute -bottom-3 opacity-50 inset-x-0 text-center">Secs</div>
                            </div>
                        </div>
                        <div class="filler bg-[#333] absolute -left-[1000px] -right-[1000px] inset-y-0 z-0 md:left-0 md:-right-[5000px]"></div>
                    </div>


                </div>
            </div>
        </div>
    </div>
</CampaignStickyHeaderController>