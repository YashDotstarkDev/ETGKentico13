---

<div class="widget package-sticky-footer" data-widget="package-sticky-footer">
    <div class="tag js-mini-discounts-offers">
        <div class="title">VANCOUVER ON SALE</div>
        <div class="title">SAVE $100pp</div>
        <div class="counter-container">
            <div class="timer js-discounts-offers-timer">
                <div class="timer-unit">
                    <span data-timer-unit="days"></span>
                </div>
                <div class="timer-unit">
                    <span data-timer-unit="hours"></span>
                </div>
                <div class="timer-unit">
                    <span data-timer-unit="minutes"></span>
                </div>
                <div class="timer-unit">
                    <span data-timer-unit="seconds"></span>
                </div>
            </div>
            <div class="counter-label">Remaining</div>
        </div>
    </div>

    <div class="bar expand-sticky">

        <div class="expand-sticky-trigger">
            <div class="icon up fas fa-chevron-up"></div>
            <div class="icon down fas fa-chevron-down"></div>
        </div>

        <div class="left">
            <div class="top">
                <div class="package-name">Moana Sands Lagoon Resort & Tamanu Beach Resort</div>
            </div>

            <div class="bottom">
                <div class="destination">Cook Islands</div>

                <!-- HELP-1988 Non-strike price
                <div class="prices">
                  <div class="price-actual">
                    From <span class="price-currency">AUD</span> <span class="price-value">4,392</span>
                  </div>
                </div>
                -->
                <!-- HELP-1988 Strike price -->
                <div class="prices">
                    <div class="price-from">
                        From <span class="strike"><span class="price-currency">AUD</span> <span class="price-value">4,892</span></span>
                    </div>
                    <div class="price-actual">
                        <span class="price-currency">AUD</span> <span class="price-value">4,392</span>
                    </div>
                </div>

            </div>
        </div>

        <a class="reviews flex items-center gap-3 shrink-0 text-body hover:no-underline" target="_blank" href="#reviews">
            <div class="logo shrink-0">
                <img src="/images/google-review-logo.png" width="52" height="46"/>
            </div>
            <div class="flex flex-col gap-1">
                <div class="stars flex items-center justify-start -ml-1 gap-1">
                    <svg class="w-6 h-6 text-yellow-300 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 22 20">
                        <path d="M20.924 7.625a1.523 1.523 0 0 0-1.238-1.044l-5.051-.734-2.259-4.577a1.534 1.534 0 0 0-2.752 0L7.365 5.847l-5.051.734A1.535 1.535 0 0 0 1.463 9.2l3.656 3.563-.863 5.031a1.532 1.532 0 0 0 2.226 1.616L11 17.033l4.518 2.375a1.534 1.534 0 0 0 2.226-1.617l-.863-5.03L20.537 9.2a1.523 1.523 0 0 0 .387-1.575Z"/>
                    </svg>
                    <svg class="w-6 h-6 text-yellow-300 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 22 20">
                        <path d="M20.924 7.625a1.523 1.523 0 0 0-1.238-1.044l-5.051-.734-2.259-4.577a1.534 1.534 0 0 0-2.752 0L7.365 5.847l-5.051.734A1.535 1.535 0 0 0 1.463 9.2l3.656 3.563-.863 5.031a1.532 1.532 0 0 0 2.226 1.616L11 17.033l4.518 2.375a1.534 1.534 0 0 0 2.226-1.617l-.863-5.03L20.537 9.2a1.523 1.523 0 0 0 .387-1.575Z"/>
                    </svg>
                    <svg class="w-6 h-6 text-yellow-300 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 22 20">
                        <path d="M20.924 7.625a1.523 1.523 0 0 0-1.238-1.044l-5.051-.734-2.259-4.577a1.534 1.534 0 0 0-2.752 0L7.365 5.847l-5.051.734A1.535 1.535 0 0 0 1.463 9.2l3.656 3.563-.863 5.031a1.532 1.532 0 0 0 2.226 1.616L11 17.033l4.518 2.375a1.534 1.534 0 0 0 2.226-1.617l-.863-5.03L20.537 9.2a1.523 1.523 0 0 0 .387-1.575Z"/>
                    </svg>
                    <svg class="w-6 h-6 text-yellow-300 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 22 20">
                        <path d="M20.924 7.625a1.523 1.523 0 0 0-1.238-1.044l-5.051-.734-2.259-4.577a1.534 1.534 0 0 0-2.752 0L7.365 5.847l-5.051.734A1.535 1.535 0 0 0 1.463 9.2l3.656 3.563-.863 5.031a1.532 1.532 0 0 0 2.226 1.616L11 17.033l4.518 2.375a1.534 1.534 0 0 0 2.226-1.617l-.863-5.03L20.537 9.2a1.523 1.523 0 0 0 .387-1.575Z"/>
                    </svg>
                    <svg class="w-6 h-6 text-yellow-300 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 22 20">
                        <path d="M20.924 7.625a1.523 1.523 0 0 0-1.238-1.044l-5.051-.734-2.259-4.577a1.534 1.534 0 0 0-2.752 0L7.365 5.847l-5.051.734A1.535 1.535 0 0 0 1.463 9.2l3.656 3.563-.863 5.031a1.532 1.532 0 0 0 2.226 1.616L11 17.033l4.518 2.375a1.534 1.534 0 0 0 2.226-1.617l-.863-5.03L20.537 9.2a1.523 1.523 0 0 0 .387-1.575Z"/>
                    </svg>
                </div>
                <div class="text text-sm whitespace-nowrap tracking-tight">
                    <span class="rating text-lg">4.9</span> stars, 152 reviews
                </div>
            </div>
        </a>

        <div class="right">
            <!-- HELP-1988 Non-strike price
            <div class="prices">
              <div class="price-actual">
                From <span class="price-currency">AUD</span> <span class="price-value">4,392</span>
              </div>
            </div>
            -->
            <!-- HELP-1988 Strike price -->
            <div class="prices">
                <div class="price-from">
                    From <span class="strike"><span class="price-currency">AUD</span> <span class="price-value">4,892</span></span>
                </div>
                <div class="price-actual">
                    <span class="price-currency">AUD</span> <span class="price-value">4,392pp</span>
                </div>
            </div>

            <!-- TODO handle 'Pick Your Dates' button function -->
            <!-- TODO handle 'Travel Agent Quote & Book' button function -->
            <div class="buttons">
                <button class="button ui primary book-now-trigger" data-scrollto-target=".form-steps">Pick Your Dates</button>
