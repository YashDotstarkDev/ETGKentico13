<div class="widget package-itinerary" data-widget="package-itinerary">
    <div class="top">
        <h2>Itinerary</h2>

        <div class="expand">
            <a href="/pdf/@tourInfo.TourCode" class="button ui primary transparent" target="_blank">Download Itinerary</a>
            <a href="#" class="expander button ui primary transparent down">Expand All</a>
        </div>
    </div>

