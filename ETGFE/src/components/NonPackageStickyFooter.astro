---
import NonPackageStickyFooterController from './NonPackageStickyFooterController.vue';
---

<NonPackageStickyFooterController client:only="vue">
    <div class="non-package-sticky-footer fixed bottom-0 inset-x-0 z-[500]">
        <div class="inner-container translate-y-[110%] transition-all duration-300 [.scrolled_&]:translate-y-0 py-4 lg:py-6 bg-white shadow-[0_-1px_5px_rgba(0,0,0,0.1)]">
            <div class="padded">
                <div class="flex flex-col md:flex-row items-center justify-between gap-6 md:gap-8">


                    <div class="hidden md:flex flex-col lg:flex-row items-center lg:gap-8">
                        <div class="font-bold text-[16px] lg:text-[20px] uppercase font-headings text-black">Connect with us</div>
                        <a href="tel:12334546" class="flex items-center gap-2 text-[16px] lg:text-[20px] text-black hover:no-underline hover:text-primary">
                            <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M4.48438 1.43359L5.57812 4.05859C5.76953 4.49609 5.66016 5.01562 5.27734 5.31641L3.9375 6.4375C4.83984 8.35156 6.39844 9.91016 8.3125 10.8125L9.43359 9.47266C9.73438 9.08984 10.2539 8.98047 10.6914 9.17188L13.3164 10.2656C13.8359 10.457 14.082 11.0312 13.9453 11.5508L13.2891 13.957C13.1523 14.4219 12.7422 14.75 12.25 14.75C5.46875 14.75 0 9.28125 0 2.5C0 2.00781 0.328125 1.59766 0.792969 1.46094L3.19922 0.804688C3.71875 0.667969 4.29297 0.914062 4.48438 1.43359Z" fill="#CA568E"/>
                            </svg>
                            AU: (02) 9094 3322
                        </a>
                    </div>

                    <div class="flex flex-col md:flex-row items-center gap-4 md:gap-8">
                        <a class="reviews flex items-center gap-3 shrink-0 text-body hover:no-underline" target="_blank" href="#reviews">
                            <div class="logo">
                                <img src="/images/google-review-logo.png" width="52" height="46"/>
                            </div>
                            <div class="flex flex-col gap-1">
                                <div class="stars flex items-center justify-start -ml-1 gap-1">
                                    <svg class="w-6 h-6 text-yellow-300 ms-1" aria-hidden="true"
                                         xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 22 20">
                                        <path d="M20.924 7.625a1.523 1.523 0 0 0-1.238-1.044l-5.051-.734-2.259-4.577a1.534 1.534 0 0 0-2.752 0L7.365 5.847l-5.051.734A1.535 1.535 0 0 0 1.463 9.2l3.656 3.563-.863 5.031a1.532 1.532 0 0 0 2.226 1.616L11 17.033l4.518 2.375a1.534 1.534 0 0 0 2.226-1.617l-.863-5.03L20.537 9.2a1.523 1.523 0 0 0 .387-1.575Z"/>
                                    </svg>
                                    <svg class="w-6 h-6 text-yellow-300 ms-1" aria-hidden="true"
                                         xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 22 20">
                                        <path d="M20.924 7.625a1.523 1.523 0 0 0-1.238-1.044l-5.051-.734-2.259-4.577a1.534 1.534 0 0 0-2.752 0L7.365 5.847l-5.051.734A1.535 1.535 0 0 0 1.463 9.2l3.656 3.563-.863 5.031a1.532 1.532 0 0 0 2.226 1.616L11 17.033l4.518 2.375a1.534 1.534 0 0 0 2.226-1.617l-.863-5.03L20.537 9.2a1.523 1.523 0 0 0 .387-1.575Z"/>
                                    </svg>
                                    <svg class="w-6 h-6 text-yellow-300 ms-1" aria-hidden="true"
                                         xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 22 20">
                                        <path d="M20.924 7.625a1.523 1.523 0 0 0-1.238-1.044l-5.051-.734-2.259-4.577a1.534 1.534 0 0 0-2.752 0L7.365 5.847l-5.051.734A1.535 1.535 0 0 0 1.463 9.2l3.656 3.563-.863 5.031a1.532 1.532 0 0 0 2.226 1.616L11 17.033l4.518 2.375a1.534 1.534 0 0 0 2.226-1.617l-.863-5.03L20.537 9.2a1.523 1.523 0 0 0 .387-1.575Z"/>
                                    </svg>
                                    <svg class="w-6 h-6 text-yellow-300 ms-1" aria-hidden="true"
                                         xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 22 20">
                                        <path d="M20.924 7.625a1.523 1.523 0 0 0-1.238-1.044l-5.051-.734-2.259-4.577a1.534 1.534 0 0 0-2.752 0L7.365 5.847l-5.051.734A1.535 1.535 0 0 0 1.463 9.2l3.656 3.563-.863 5.031a1.532 1.532 0 0 0 2.226 1.616L11 17.033l4.518 2.375a1.534 1.534 0 0 0 2.226-1.617l-.863-5.03L20.537 9.2a1.523 1.523 0 0 0 .387-1.575Z"/>
                                    </svg>
                                    <svg class="w-6 h-6 text-yellow-300 ms-1" aria-hidden="true"
                                         xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 22 20">
                                        <path d="M20.924 7.625a1.523 1.523 0 0 0-1.238-1.044l-5.051-.734-2.259-4.577a1.534 1.534 0 0 0-2.752 0L7.365 5.847l-5.051.734A1.535 1.535 0 0 0 1.463 9.2l3.656 3.563-.863 5.031a1.532 1.532 0 0 0 2.226 1.616L11 17.033l4.518 2.375a1.534 1.534 0 0 0 2.226-1.617l-.863-5.03L20.537 9.2a1.523 1.523 0 0 0 .387-1.575Z"/>
                                    </svg>
                                </div>
                                <div class="text text-sm whitespace-nowrap tracking-tight">
                                    <span class="rating text-lg">4.9</span> stars, 152 reviews
                                </div>
                            </div>
                        </a>

                        <a href="#page" class="ui button primary !py-[5px] !px-[15px] md:!py-[13px] md:!px-[30px]">
                            <svg width="14" height="13" viewBox="0 0 14 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12.1562 0.59375L1.28125 6.85156C0.859375 7.08594 0.90625 7.69531 1.32812 7.85938L3.83594 8.91406L10.5625 2.98438C10.6797 2.86719 10.8672 3.03125 10.75 3.17188L5.125 10.0391V11.9375C5.125 12.5 5.78125 12.7109 6.10938 12.3125L7.60938 10.4844L10.5156 11.7266C10.8438 11.8672 11.2422 11.6562 11.2891 11.2812L12.9766 1.15625C13.0703 0.6875 12.5547 0.359375 12.1562 0.59375Z"
                                      fill="currentColor"/>
                            </svg>
                            Enquire now
                        </a>
                    </div>



                </div>
            </div>
        </div>
    </div>
</NonPackageStickyFooterController>