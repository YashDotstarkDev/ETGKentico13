<div class="experience-ticker my-8">
    <div class="padded">
        <div class="flex flex-col min-[1800px]:flex-row min-[1800px]:items-center min-[1800px]:justify-center">
            <h4 class="text-black uppercase text-center">When experience matters</h4>
            <div class="divider h-4 w-px mx-4 hidden min-[1800px]:block bg-black/10"></div>
            <div class="items flex flex-wrap gap-x-6 gap-y-2 mt-6 justify-center mx-auto max-w-3xl 2xl:max-w-none min-[1800px]:m-0">
                <div class="item">
                    <div class="label"><span class="icon fa-light fa-badge-check"></span> INDUSTRY ACCREDITED</div>
                </div>
                <div class="item">
                    <div class="label"><span class="icon fa-light fa-award"></span> AWARD WINNING</div>
                </div>
                <div class="item">
                    <div class="label"><span class="icon fa-light fa-headset"></span> TRAVEL SUPPORT</div>
                </div>
                <div class="item">
                    <div class="label"><span class="icon fa-light fa-hourglass-start"></span> 50 YEARS EXPERIENCE</div>
                </div>
                <div class="item">
                    <div class="label"><span class="icon fa-light fa-file-certificate"></span> HANDPICKED SUPPLIERS</div>
                </div>
                <div class="item">
                    <div class="label"><span class="icon fa-light fa-mountain"></span> UNRIVALLED EXPERIENCES</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!--
/////
