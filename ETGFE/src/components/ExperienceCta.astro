<div class="experience-cta">
    <div class="padded">
        <div class="inner relative rounded-3xl overflow-hidden isolate">
            <div class="aspect-video image-container relative md:aspect-auto md:absolute md:inset-0 md:z-10">
                <img data-src="https://entiretravel.imgix.net/getmedia/ba2d9bf7-c9b9-4da2-b86e-8d1451b05572/RM-Hero-Banner-1920x600.jpg?w={width}&auto=format" data-lowsrc="https://entiretravel.imgix.net/getmedia/ba2d9bf7-c9b9-4da2-b86e-8d1451b05572/RM-Hero-Banner-1920x600.jpg?w=3&auto=format" class="lazyload absolute inset-0 w-full h-full object-cover object-center" data-sizes="auto">
                <img data-src="https://entiretravel.imgix.net/images/round.png?auto=format" class="lazyload block md:hidden absolute left-0 right-0 bottom-0">
            </div>
            <div class="content bg-black p-6 text-white relative z-20 md:w-[65%] md:pr-[150px] md:bg-transparent md:p-8 lg:pl-12 lg:pt-12 lg:pb-12 max-w-[700px] xl:pl-20 xl:pt-20 xl:pb-20 xl:pr-[200px]">
                <img data-src="https://entiretravel.imgix.net/images/featured-content-panel-pattern.png?auto=format" class="lazyload hidden md:block absolute left-0 top-0 w-full h-full">
                <div class="relative z-20 flex flex-col gap-6 xl:gap-6">
                    <h2 class="uppercase text-4xl lg:text-5xl">Rocky Mountaineer 2025 Last Chance Offer</h2>
                    <div>An unforgettable way to experience the Canadian Rockies or American Southwest. Offering four unique North American rail routes and renowned for its luxurious glass-dome coaches, Rocky Mountaineer is considered by many to be one of the world’s ultimate travel experiences. 2025 Last Chance Offer - Save up to $800 per couple</div>
                    <div class="cta">
                        <a href="#" class="btn btn-primary">Explore</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

