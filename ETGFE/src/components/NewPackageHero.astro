---
import ShareButton from './ShareButton.vue'
---

<!--
/////
new-package-hero Start
/////
-->

<div class="new-package-hero">
    <div class="wrapper-large relative">
        <div class="images flex gap-6">
            <div class="main-image relative flex-1">
                <div class="aspect-video image-container relative rounded-xl overflow-hidden md:aspect-auto md:h-[400px]">
                    <img
                            data-lowsrc="https://entiretravel.imgix.net/getmedia/b2d15ee2-447d-4e2f-a891-00ee32c3d8e2/tahiti_manava_beach_resort_pool.jpg?auto=format&w=3"
                            data-src="https://entiretravel.imgix.net/getmedia/b2d15ee2-447d-4e2f-a891-00ee32c3d8e2/tahiti_manava_beach_resort_pool.jpg?auto=format&w={width}"
                            data-sizes="auto"
                            class="lazyload absolute z-0 inset-0 w-full h-full object-cover group-hover:scale-105 transition-all duration-300"
                            alt="Hilton Moorea Lagoon Resort & Spa"
                    />
                </div>

                <div class="location absolute z-20 right-0 left-0 bottom-8 text-white text-xs items-center justify-center gap-2 flex px-6 md:left-auto md:bottom-12 lg:bottom-6">
                    <svg width="9" height="13" viewBox="0 0 9 13" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
                        <path d="M6.375 5C6.375 6.05469 5.53125 6.875 4.5 6.875C3.44531 6.875 2.625 6.05469 2.625 5C2.625 3.96875 3.44531 3.125 4.5 3.125C5.53125 3.125 6.375 3.96875 6.375 5ZM4.5 4.25C4.07812 4.25 3.75 4.60156 3.75 5C3.75 5.42188 4.07812 5.75 4.5 5.75C4.89844 5.75 5.25 5.42188 5.25 5C5.25 4.60156 4.89844 4.25 4.5 4.25ZM9 5C9 7.0625 6.25781 10.6953 5.03906 12.2188C4.75781 12.5703 4.21875 12.5703 3.9375 12.2188C2.71875 10.6953 0 7.0625 0 5C0 2.51562 1.99219 0.5 4.5 0.5C6.98438 0.5 9 2.51562 9 5ZM4.5 1.625C2.625 1.625 1.125 3.14844 1.125 5C1.125 5.30469 1.21875 5.75 1.47656 6.35938C1.71094 6.92188 2.0625 7.57812 2.46094 8.23438C3.14062 9.3125 3.91406 10.3438 4.5 11.0938C5.0625 10.3438 5.83594 9.3125 6.51562 8.23438C6.91406 7.57812 7.26562 6.92188 7.5 6.35938C7.75781 5.75 7.875 5.30469 7.875 5C7.875 3.14844 6.35156 1.625 4.5 1.625Z" fill="white"></path>
                    </svg>
                    London England | Credit: Jonothan Doe
                </div>

                <div class="badges absolute flex flex-row gap-3 left-6 right-6 justify-center bottom-0 translate-y-1/2 md:right-auto">
                    <div class="badge rounded-full w-9 h-9 flex items-center justify-center bg-white group/badge relative">
                        <svg width="21" height="21" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12.25 7.0625V5.96875C11.1172 4.52344 10.375 2.84375 10.1016 1.04688C10.0234 0.539062 9.35938 0.304688 9.04688 0.734375C8.1875 1.71094 7.5625 2.84375 7.13281 4.13281C8.46094 5.61719 10.2578 6.63281 12.25 7.0625ZM16.625 3C14.8672 3 13.5 4.40625 13.5 6.16406V8.46875C9.4375 8.23438 5.96094 5.73438 4.39844 2.14062C4.16406 1.67188 3.46094 1.63281 3.26562 2.10156C2.60156 3.46875 2.25 5.03125 2.25 6.63281C2.25 9.40625 3.57812 11.9844 5.57031 13.8984C6.07812 14.4062 6.58594 14.7969 7.09375 15.1875L1.46875 16.5938C1.03906 16.6719 0.84375 17.1797 1.07812 17.5312C1.78125 18.5859 3.46094 20.3828 7.05469 20.5C7.36719 20.5391 7.67969 20.4219 7.91406 20.2266L10.4922 18L13.5 18.0391C16.9375 18.0391 19.75 15.2266 19.75 11.7891V5.5L20.9609 3H16.625ZM16.625 6.78906C16.2734 6.78906 15.9609 6.47656 15.9609 6.16406C15.9609 5.8125 16.2734 5.53906 16.625 5.53906C16.9375 5.53906 17.2109 5.8125 17.2109 6.16406C17.25 6.47656 16.9375 6.78906 16.625 6.78906Z" fill="#929497"></path>
                        </svg>
                        <div class="tooltip absolute transition-opacity bottom-full -translate-y-1 left-1/2 -translate-x-1/2 opacity-0 group-hover/badge:opacity-100 whitespace-nowrap bg-gray-200 text-xs font-bold leading-none rounded p-1">
                            Peace of mind
                        </div>
                    </div>
                    <div class="badge rounded-full w-9 h-9 flex items-center justify-center bg-white group/badge relative">
                        <svg width="22" height="20" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M16.2422 0.125H5.71484L11 6.61328L16.2422 0.125ZM22 7L17.3594 0.941406L12.418 7H22ZM4.59766 0.941406L0 7H9.53906L4.59766 0.941406ZM10.4844 19.1602C10.6133 19.332 10.7852 19.375 11 19.375C11.1719 19.375 11.3438 19.332 11.4727 19.1602L21.9141 8.375H0.0429688L10.4844 19.1602Z" fill="#929497"></path>
                        </svg>
                        <div class="tooltip absolute transition-opacity bottom-full -translate-y-1 left-1/2 -translate-x-1/2 opacity-0 group-hover/badge:opacity-100 whitespace-nowrap bg-gray-200 text-xs font-bold leading-none rounded p-1">
                            Exclusive Packages
                        </div>
                    </div>
                </div>
            </div>
            <div class="side-images hidden lg:flex flex-col gap-6 lg:w-1/3 lg:min-w-[350px]">
                <div class="image-container relative rounded-xl overflow-hidden flex-1">
                    <img
                            data-lowsrc="https://entiretravel.imgix.net/getmedia/380d961c-0d3c-4ff1-97be-a54b5d04ea5e/tahiti-manava-beach-resort-aerial2.jpg?auto=format&w=3"
                            data-src="https://entiretravel.imgix.net/getmedia/380d961c-0d3c-4ff1-97be-a54b5d04ea5e/tahiti-manava-beach-resort-aerial2.jpg?auto=format&w={width}"
                            data-sizes="auto"
                            class="lazyload absolute z-0 inset-0 w-full h-full object-cover group-hover:scale-105 transition-all duration-300"
                            alt="Hilton Moorea Lagoon Resort & Spa"
                    />
                </div>
                <div class="image-container relative rounded-xl overflow-hidden flex-1">
                    <img
                            data-lowsrc="https://entiretravel.imgix.net/getmedia/8ff09c03-80a4-4ac9-9498-693b331d3ca3/tahiti_manava_beach_resort_overwater_bungalows.jpg?auto=format&w=3"
                            data-src="https://entiretravel.imgix.net/getmedia/8ff09c03-80a4-4ac9-9498-693b331d3ca3/tahiti_manava_beach_resort_overwater_bungalows.jpg?auto=format&w={width}"
                            data-sizes="auto"
                            class="lazyload absolute z-0 inset-0 w-full h-full object-cover group-hover:scale-105 transition-all duration-300"
                            alt="Hilton Moorea Lagoon Resort & Spa"
                    />
                </div>
            </div>
        </div>

        <div class="buttons flex gap-2 items-center justify-center mt-8 md:mt-0 md:absolute md:right-16 md:bottom-0 md:translate-y-1/2">
            <button class="btn btn-primary-outline bg-white">Show all photos</button>
            <ShareButton client:only="vue" url="https://url.to.share" title="Title to share" text="Text to share" />
        </div>
    </div>
</div>

<!--
/////
new-package-hero End
/////
-->
