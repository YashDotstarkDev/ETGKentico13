<?xml version="1.0" encoding="utf-8" ?>
<grid>
  <actions>
    <action externalsourcename="edit" name="edit" caption="$General.Edit$" fonticonclass="icon-edit" fonticonstyle="allow" />
	<action name="#delete" caption="$General.Delete$" fonticonclass="icon-bin" fonticonstyle="critical" confirmation="$General.ConfirmDelete$" />
    <action name="empty" contextmenu="~" />
  </actions>
  <columns>
    <column source="AgentLogoAgencyName" caption="Agency Name" wrap="false" localize="true">
	    <filter type="text" size="200" />
    </column>
    <column source="AgentLogoDomain" caption="Domain" wrap="false" localize="true">
        <filter type="text" size="200" />
    </column>
    <column source="AgentLogoID" caption="Email Address" wrap="false" localize="true" externalsourcename="agentlogoid" visible="false" >
        <filter type="custom" path="~/Custom/ETGBooking/UI/Filters/AgentEmailFilter.ascx" />
    </column>
  </columns>
  <options>
    <key name="DisplayFilter" value="true" />
    <key name="AllowSorting" value="true" />
    <key name="FilterLimit" value="0" />
  </options>
</grid>