@using System.Activities.Statements
@using ETG.Core.Extensions
@using Castle.Core.Internal
@using DocumentFormat.OpenXml.Drawing.Diagrams
@model ETG.Web.Models.Pages.HomeViewModel

@{
    if (Model.HeroSliderImages.IsNullOrEmpty())
    {
        return;
    }
    var tempIndex = 0;
}

@{ 
    string hiddenH1 = Model.HeroSliderImages.Any() ? Model.HeroSliderImages.FirstOrDefault()?.ImageCaption : "Holiday Packages and Deals";
}
<h1 class="visually-hidden">@hiddenH1</h1>
<div class="homepage-hero z-10">
    <div class="padded">
        <div class="inner relative h-[420px] flex items-center justify-center">
            @foreach (var image in Model.HeroSliderImages)
            {
                tempIndex++;
                <div class="absolute inset-0 rounded-3xl overflow-hidden image-container bg-black">
                    <img data-lowsrc="@Html.Raw(image.ImagePath.ImgixifyLowRes())" data-src="@Html.Raw(image.ImagePath.Imgixify(1296, 420))" data-sizes="auto" class="lazyload absolute z-0 inset-0 w-full h-full object-cover opacity-80" alt="@image.ImageCaption">
                    <div class="gradient-overlay absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-black/50 to-black/0 opacity-80 z-10"></div>
                </div>
                <div class="location absolute z-20 inset-x-0 bottom-12 text-white text-xs items-center justify-center gap-2 flex px-6 text-left 2xl:left-auto 2xl:bottom-6">
                    <svg width="9" height="13" viewBox="0 0 9 13" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
                        <path d="M6.375 5C6.375 6.05469 5.53125 6.875 4.5 6.875C3.44531 6.875 2.625 6.05469 2.625 5C2.625 3.96875 3.44531 3.125 4.5 3.125C5.53125 3.125 6.375 3.96875 6.375 5ZM4.5 4.25C4.07812 4.25 3.75 4.60156 3.75 5C3.75 5.42188 4.07812 5.75 4.5 5.75C4.89844 5.75 5.25 5.42188 5.25 5C5.25 4.60156 4.89844 4.25 4.5 4.25ZM9 5C9 7.0625 6.25781 10.6953 5.03906 12.2188C4.75781 12.5703 4.21875 12.5703 3.9375 12.2188C2.71875 10.6953 0 7.0625 0 5C0 2.51562 1.99219 0.5 4.5 0.5C6.98438 0.5 9 2.51562 9 5ZM4.5 1.625C2.625 1.625 1.125 3.14844 1.125 5C1.125 5.30469 1.21875 5.75 1.47656 6.35938C1.71094 6.92188 2.0625 7.57812 2.46094 8.23438C3.14062 9.3125 3.91406 10.3438 4.5 11.0938C5.0625 10.3438 5.83594 9.3125 6.51562 8.23438C6.91406 7.57812 7.26562 6.92188 7.5 6.35938C7.75781 5.75 7.875 5.30469 7.875 5C7.875 3.14844 6.35156 1.625 4.5 1.625Z" fill="white"></path>
                    </svg>
                    @Html.Raw(image.ImageCaption)
                </div>

                @*display only 1 hero banner for optimisation purpose*@
                if (tempIndex > 0)
                {
                    break;
                }
            }

            <astro-island uid="1o18cH" component-url="/scripts/HomepageHeroSearch.js" component-export="default" renderer-url="/scripts/client.js" props="{&quot;appId&quot;:[0,&quot;@Model.SearchAppId&quot;],&quot;apiKey&quot;:[0,&quot;@Model.SearchApiKey&quot;],&quot;indexName&quot;:[0,&quot;@Model.SearchIndexName&quot;],&quot;searchUrl&quot;:[0,&quot;/search?from=homepage&quot;]}" ssr client="only" opts="{&quot;name&quot;:&quot;HomepageHeroSearch&quot;,&quot;value&quot;:&quot;vue&quot;}"></astro-island>
        </div>
    </div>
</div>
