@using Castle.Core.Internal
@model ETG.Data.Settings.Models.ETGSettings
    
@if (Model == null)
{
    return;
}

@if (!Model.GTMID.IsNullOrEmpty())
{
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=@Model.GTMID"
                      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
}
