                    @foreach (var logo in Model.BottomLogos)
                    {
                        <div class="logo relative h-12">
                            <img class="lazyload block absolute left-0 top-0 w-full h-full object-contain" data-src="@logo.ImagePath.Imgixify()&bri=100" data-sizes="auto" alt="@logo.ImageAltText">
