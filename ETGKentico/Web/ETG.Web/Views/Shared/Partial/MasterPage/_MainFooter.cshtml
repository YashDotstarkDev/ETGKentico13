                © @Html.Raw(DateTime.UtcNow.Year) Entire Travel Group Pty Ltd ABN 60 625 410 755.
            </div>
            <div class="links flex flex-wrap justify-center gap-4">
                @if (Model != null && !Model.BottomMenus.IsNullOrEmpty())
                {
                    foreach (var menu in Model.BottomMenus)
                    {
                        var isDevotionLink = menu.Label.Contains("Devotion");
                        if (isDevotionLink)
                        {
                            <a target="_blank" href="@menu.Path.ToLower()" rel="nofollow">
                                @menu.Label
                            </a>
                        }
                        else
                        {
                            <a target="_self" href="@menu.Path.ToLower()">
                                @menu.Label
                            </a>
                        }
                    }
                }
            </div>
        </div>
    </div>
</footer>