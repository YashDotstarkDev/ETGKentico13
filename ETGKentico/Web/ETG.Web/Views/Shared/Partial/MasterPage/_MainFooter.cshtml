@using Castle.Core.Internal
@using ETG.Core.Extensions
@model ETG.Web.Models.Layout.FooterViewModel

<footer class="bg-[#333] text-white">
    <div class="wrapper">
        <div class="py-6 hidden lg:block">
            <div class="grid grid-cols-5 gap-8">
                @foreach (var menuGroup in Model.TopMenus)
                {
                    <astro-island component-url="/scripts/JumpMenu.js" component-export="default" renderer-url="/scripts/client.js" props="@Model.GetMenuAstroProps(menuGroup).AsEncodedAstroProps()" ssr client="only" opts="{&quot;name&quot;:&quot;JumpMenu&quot;,&quot;value&quot;:&quot;vue&quot;}"></astro-island>
                }
            </div>
        </div>
        <div class="pt-12 lg:pt-6">
            <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
                <div>
                    <h2 class="uppercase">Our friendly team would love to help</h2>
                </div>
                @if (Model.Contact != null)
                {
                    <div class="contact flex flex-col gap-2">
                        @if (!Model.Contact.OpeningHours.IsNullOrEmpty())
                        {
                            <div class="line flex flex-row gap-3 items-start">
                                <span class="icon mt-1 fal fa-clock"></span> @Model.Contact.OpeningHours
                            </div>
                        }

                        @if (!Model.Contact.Address1.IsNullOrEmpty())
                        {
                            <div class="line flex flex-row gap-3 items-start">
                                <span class="icon mt-1 fal fa-envelope"></span> @Model.Contact.Address1
                                @if (!Model.Contact.Address2.IsNullOrEmpty())
                                {
                                    <br />
                                    @Model.Contact.Address2
                                }
                            </div>
                        }

                        @if (!Model.Contact.PhoneNumber.IsNullOrEmpty())
                        {
                            <div class="line flex flex-row gap-3 items-start">
                                <span class="icon mt-1 fal fa-phone"></span> @Model.Contact.PhoneNumber
                                @if (!Model.Contact.PhoneNumber2.IsNullOrEmpty())
                                {
                                    <br />
                                    @Model.Contact.PhoneNumber2
                                }
                            </div>
                        }

                        @if (!Model.Contact.EmailAddress.IsNullOrEmpty())
                        {
                            <div class="line flex flex-row gap-3 items-start">
                                <span class="icon mt-1 fal fa-paper-plane"></span><a href="mailto:@Model.Contact.EmailAddress">@Model.Contact.EmailAddress</a>
                            </div>
                        }

                        <div class="line flex flex-row gap-3 items-start">
                            <span class="icon mt-1.5 fal fa-thumbs-up"></span>
                            @if (!Model.Contact.FacebookUrl.IsNullOrEmpty())
                            {
                                <a href="@Model.Contact.FacebookUrl" target="_blank" rel="nofollow" class="text-white hover:text-primary text-lg">
                                    <span class="fab fa-facebook"></span>
                                </a>
                            }
                            @if (!Model.Contact.InstagramUrl.IsNullOrEmpty())
                            {
                                <a href="@Model.Contact.InstagramUrl" target="_blank" rel="nofollow" class="text-white hover:text-primary text-lg">
                                    <span class="fab fa-instagram"></span>
                                </a>
                            }
                            @if (!Model.Contact.LinkedInUrl.IsNullOrEmpty())
                            {
                                <a href="@Model.Contact.LinkedInUrl" target="_blank" rel="nofollow" class="text-white hover:text-primary text-lg">
                                    <span class="fab fa-linkedin"></span>
                                </a>
                            }
                            @if (!Model.Contact.YouTubeUrl.IsNullOrEmpty())
                            {
                                <a href="@Model.Contact.YouTubeUrl" target="_blank" rel="nofollow" class="text-white hover:text-primary text-lg">
                                    <span class="fab fa-youtube"></span>
                                </a>
                            }
                        </div>
                    </div>
                }
            <div class="logos">
