@using Castle.Core.Internal
@using ETG.Core.Extensions;
@model List<ETG.Web.Article.Models.ArticleViewModel>

@if (Model.IsNullOrEmpty())
{
    return;
}


<div class="flex flex-wrap -mx-4 justify-center mt-8">
    @foreach (var article in Model)
    {
        <div class="tile p-4 w-full md:w-1/2 xl:w-1/4">
            <a href="@article.Url.ToLower()" class="block hover:no-underline relative text-body group"> 
            <span class="block image-container w-full h-[180px] relative rounded-md overflow-hidden isolate"> 
                <img data-lowsrc="@article.HeroImage.ImgixifyLowRes()" data-src="@article.HeroImage.Imgixify(380, 214, true)" data-sizes="auto" class="lazyload absolute z-0 inset-0 w-full h-full object-cover group-hover:scale-105 transition-all duration-300" alt="@article.Title"> 
                </span>
            <span class="flex flex-col justify-end gap-2 py-4 relative z-20"> 
                <span class="text-xs font-bold uppercase">@article.CategoriesText</span> 
                <span class="text-lg text-primary group-hover:text-body transition-colors duration-300 font-normal">@Html.Raw(article.Title)</span> 
            </span> 
            </a>
        </div>
    }

</div>

