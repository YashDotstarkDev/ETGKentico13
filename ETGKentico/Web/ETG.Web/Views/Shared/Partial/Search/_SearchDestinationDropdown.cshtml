@using Castle.Core.Internal

@model List<ETG.Web.Models.Menu.MenuGroup>
@if (Model.IsNullOrEmpty())
{
    return;
}
<div class="submenu where-submenu">
    <div class="columns">
        @foreach (var menu in Model)
        {
            <div class="column">
                <div class="heading">@menu.Link.Label</div>
                <div class="items">
                    @foreach (var destination in menu.ChildLinks)
                    {
                        <div class="item" data-value="@destination.Label">@destination.Label</div>  
                    }
                </div>
            </div>
        }
    </div>
</div>