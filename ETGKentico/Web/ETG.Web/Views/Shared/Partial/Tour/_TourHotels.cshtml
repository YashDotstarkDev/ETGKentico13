@using System.Web.UI.WebControls
@using Castle.Core.Internal
@using ETG.Core.Extensions;
@model ETG.Web.Tour.Models.TourPageViewModel

@if (Model.Hotels.IsNullOrEmpty())
{
    return;
}
<div class="scroll-section" id="section_accommodation">
    <div class="widget package-hotels" data-widget="package-hotels">
        <div class="wrapper">
            <div class="top">
                <h2>Accommodation</h2>
            </div>
            
            <div class="ui styled fluid accordion hotels">
                @foreach (var hotel in Model.Hotels)
                {
                    <div class="title @(ViewBag.IsPrint == null ? "" : " active")">
                        <div class="w-heading">
                            <h3 class="heading">
                                <span class="stars" data-rating="@hotel.Review"></span> @hotel.Name
                            </h3>
                            @if (!hotel.RoomUpgrades.IsNullOrEmpty())
                            {
                                <span class="label">Upgrade available</span>
                            }
                        </div>
                        @if (ViewBag.IsPrint == null)
                        {
                            <i class="dropdown icon"></i>
                        }
                    </div>

                    <div class="content @(ViewBag.IsPrint == null ? "" : " active")">
                        <div class="inner-content">
                            @Html.Raw(hotel.Detail)

                            @if (hotel.Images.Count() > 1)
                            {
                                <div class="image-grid">
                                    <div class="i-image-grid">
                                        @foreach (var image in hotel.Images)
                                        {
                                            <div class="image">
                                                @if (ViewBag.IsPrint == null)
                                                {
                                                    <img class="lazyload"
                                                         data-src="@image.Key.Imgixify()" alt="@image.Value">
                                                }
                                                else
                                                {
                                                    <img src="@image.Key.Imgixify()" alt="@image.Value">
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                foreach (var image in hotel.Images)
                                {
                                    <div class="image">
                                        @if (ViewBag.IsPrint == null)
                                        {
                                            <img class="lazyload"
                                                 data-src="@image.Key.Imgixify()" alt="@image.Value">
                                        }
                                        else
                                        {
                                            <img src="@image.Key.Imgixify()" alt="@image.Value">
                                        }
                                    </div>
                                }
                            }

                            @if (!hotel.Facilities.IsNullOrEmpty())
                            {
                                <div class="hotel-facilities">
                                    @Html.Raw(hotel.Facilities)
                                </div>
                            }

                            @if (!hotel.Stats.IsNullOrEmpty())
                            {
                                <h4>Stats</h4>
                                @Html.Raw(hotel.Stats)
                            }
                        </div>
                        
                        @if (!hotel.RoomUpgrades.IsNullOrEmpty())
                        {
                            <h4>Room Upgrades</h4>

                            foreach (var upgrade in hotel.RoomUpgrades)
                            {
                                <h5>@upgrade.Title</h5>
                                @Html.Raw(upgrade.Description)

                                if (!upgrade.Image.IsNullOrEmpty())
                                {
                                    <div class="image">
                                        @if (ViewBag.IsPrint == null)
                                        {
                                            <img class="lazyload"
                                                 data-src="@upgrade.Image.Imgixify()" alt="@upgrade.Title">   
                                        }
                                        else
                                        {
                                         
                                            <img src="@upgrade.Image.Imgixify()" alt="@upgrade.Title">   
                                        }
                                    </div>
                                }
                                
                                <div class="icons-listing">
                                    @if (!upgrade.PriceStatements.IsNullOrEmpty())
                                    {
                                        <div class="item">
                                            <span class="icon fa-light fa-circle-dollar"></span>
                                            @Html.Raw(upgrade.PriceStatements)
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="item">
                                            <span class="icon fa-light fa-circle-dollar"></span>
                                            @if (ViewBag.IsPrint != null)
                                            {
                                                <p>
                                                    Prices are dynamic based on travel dates. Please proceed to <a href="@Model.TourInfo.TourSummaryInfo.Path">Book Now</a> or <a href="https://www.entiretravel.com.au/enquire/@Model.TourInfo.TourSummaryInfo.TourCode" target="_blank">Contact Us</a> for details.
                                                </p>
                                            }
                                            else
                                            {
                                                <p>Prices are dynamic based on travel dates. Please proceed to <a href="#" class="js-scrollto-book-now">Book Now</a> or <a href="https://www.entiretravel.com.au/enquire/@Model.TourInfo.TourSummaryInfo.TourCode" target="_blank">Contact Us</a> for details.</p>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>