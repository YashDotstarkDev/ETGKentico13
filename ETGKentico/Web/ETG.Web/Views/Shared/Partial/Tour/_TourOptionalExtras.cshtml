@using Castle.Core.Internal
@using ETG.Core.Extensions;
@using Microsoft.Ajax.Utilities
@model ETG.Web.Tour.Models.TourPageViewModel


@if (Model.OptionalExtras.IsNullOrEmpty())
{
    return;
}

<div class="scroll-section" id="section_optional-extras">
    <div class="widget package-accordion" data-widget="package-accordion">
        <div class="top">
            <h2>Optional Extras</h2>
        </div>
        
        <div class="ui styled fluid accordion">
            <div class="accordion-panel">
                @foreach (var option in Model.OptionalExtras)
                {
                    <div class="title @(ViewBag.IsPrint == null ? "" : " active")">
                        <h3 class="heading">@Html.Raw(option.Title)</h3>
                        <i class="dropdown icon"></i>
                    </div>

                    <div class="content @(ViewBag.IsPrint == null ? "" : " active")">
                        <div class="inner-content">
                            @Html.Raw(option.Description)
                            
                            @if (!option.Image.IsNullOrEmpty())
                            {
                                <div class="image image-w-caption">
                                    @if (ViewBag.IsPrint == null)
                                    {
                                        <img class="lazyload" data-sizes="auto" data-src="@option.Image.Imgixify()"/>
                                    }
                                    else
                                    {
                                        <img src="@option.Image.Imgixify()"/>
                                    }

                                    @if (!option.ImageCaption.IsNullOrEmpty())
                                    {
                                        <div class="caption">
                                            <svg width="9" height="13" viewBox="0 0 9 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path
                                                    d="M6.375 5C6.375 6.05469 5.53125 6.875 4.5 6.875C3.44531 6.875 2.625 6.05469 2.625 5C2.625 3.96875 3.44531 3.125 4.5 3.125C5.53125 3.125 6.375 3.96875 6.375 5ZM4.5 4.25C4.07812 4.25 3.75 4.60156 3.75 5C3.75 5.42188 4.07812 5.75 4.5 5.75C4.89844 5.75 5.25 5.42188 5.25 5C5.25 4.60156 4.89844 4.25 4.5 4.25ZM9 5C9 7.0625 6.25781 10.6953 5.03906 12.2188C4.75781 12.5703 4.21875 12.5703 3.9375 12.2188C2.71875 10.6953 0 7.0625 0 5C0 2.51562 1.99219 0.5 4.5 0.5C6.98438 0.5 9 2.51562 9 5ZM4.5 1.625C2.625 1.625 1.125 3.14844 1.125 5C1.125 5.30469 1.21875 5.75 1.47656 6.35938C1.71094 6.92188 2.0625 7.57812 2.46094 8.23438C3.14062 9.3125 3.91406 10.3438 4.5 11.0938C5.0625 10.3438 5.83594 9.3125 6.51562 8.23438C6.91406 7.57812 7.26562 6.92188 7.5 6.35938C7.75781 5.75 7.875 5.30469 7.875 5C7.875 3.14844 6.35156 1.625 4.5 1.625Z"
                                                    fill="white"/>
                                            </svg>
                                            @option.ImageCaption
                                        </div>
                                    }
                                </div>
                            }
                            
                            <div class="icons-listing">
                                @if (!option.Duration.IsNullOrEmpty())
                                {
                                    <div class="item">
                                        <span class="icon fa-light fa-clock"></span>
                                        <p>@option.Duration</p>
                                    </div>
                                }

                                @if (!option.AvailabledaysOfWeekText.IsNullOrEmpty())
                                {
                                    <div class="item">
                                        <span class="icon fa-light fa-clock"></span>
                                        <p>Operates on @option.AvailabledaysOfWeekText</p>
                                    </div>
                                }
                                
                                @if (!option.AvailableDateRange.IsNullOrEmpty())
                                {
                                    <div class="item">
                                        <span class="icon fa-light fa-clock"></span>
                                        <p>From @option.AvailableDateRange</p>
                                    </div>
                                }
                                
                                @if (!option.PriceStatements.IsNullOrEmpty())
                                {
                                    <div class="item">
                                        <span class="icon fa-light fa-circle-dollar"></span>
                                        @Html.Raw(option.PriceStatements)
                                    </div>
                                }
                                else
                                {
                                    <div class="item">
                                        <span class="icon fa-light fa-circle-dollar"></span>
                                        @if (ViewBag.IsPrint != null)
                                        {
                                            <p>
                                                Prices are dynamic based on travel dates. Please proceed to <a href="@Model.TourInfo.TourSummaryInfo.Path">Book Now</a> or <a href="https://www.entiretravel.com.au/enquire/@Model.TourInfo.TourSummaryInfo.TourCode" target="_blank">Contact Us</a> for details.
                                            </p>
                                        }
                                        else
                                        {
                                            <p>Prices are dynamic based on travel dates. Please proceed to <a href="#" class="js-scrollto-book-now">Book Now</a> or <a href="https://www.entiretravel.com.au/enquire/@Model.TourInfo.TourSummaryInfo.TourCode" target="_blank">Contact Us</a> for details.</p>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>