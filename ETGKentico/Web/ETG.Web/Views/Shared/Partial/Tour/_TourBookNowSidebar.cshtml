<div class="booking-summary js-booking-summary" style="display: none;">
    <div class="booking-summary-section booking-summary-breakdown">
        <h4>Booking Summary</h4>
        <h5></h5>
        <div class="package">
            <div class="item">
                <div class="item-name">
                    <div class="label"></div>
                    <div class="qty"></div>
                </div>
                <div class="price"></div>
            </div>
            <div class="item">
                <div>
                    <div class="prepost-nights-breakdown"></div>
                    <div class="roomtypes-breakdown"></div>
                </div>
            </div>
        </div>
         <div class="single-package">
             <div class="item">
                 <div class="item-name">
                     <div class="label"></div>
                     <div class="qty"></div>
                 </div>
                 <div class="price"></div>
             </div>
             <div class="item">
                 <div>
                     <div class="prepost-nights-breakdown"></div>
                 </div>
             </div>
        </div>
        <div class="item room-option">
            <div class="item-name">
                <div class="label">Room Upgrades</div>
                <div class="room-list"></div>
            </div>

            <div class="price"></div>
        </div>
        <div class="item extras-option">
            <div class="item-name">
                <div class="label">Extras</div>
                <div class="extras-list"></div>
            </div>
            <div class="price"></div>
        </div>

        <div class="item entire-flex">
            <div class="item-name">
                <div class="label"></div>
                <div class="qty"></div>
            </div>
            <div class="price"></div>
        </div>
        <div class="item discount">
            <div class="item-name">
                <div class="label"></div>
                <div class="qty"></div>
            </div>
            <div class="price"></div>
        </div>
        <div class="item total item-full">
            <div class="inner">
                <div class="total-label">Total</div>
                <div class="total-price"><span></span>
                     @if (!currencyPricing.CurrentCurrencyIsAUD)
                     {
                         <br/>
                         <div class="price-aud">
                             (AUD <span></span>)
                         </div>
                     }
                </div>
            </div>
            <div class="terms">
                @if (Model.DaysFromDepartureDateForFullPayment > 0)
                {
                    <div class="full-payment-message">
                        The date you have selected is less than @Model.DaysFromDepartureDateForFullPayment days. Full payment is required at time of booking*
                    </div>
                }
                @if (Model.Tour.TourSummaryInfo.TourIsOnSaleNow && Model.Tour.TourSummaryInfo.OnSaleFullpaymentRquired)
                {
                    <div>
                        On Sale Now packages require full payment at time of booking.
                    </div>
                }
                <div class="full-payment-additional-message">

                </div>
            </div>
        </div>
    </div>
    <div class="booking-summary-section deposit-due">
        <h4>Due Now</h4>

        <div class="item deposit">
            <div class="item-name">
                <div class="label">Deposit</div>
                <div class="qty"></div>
            </div>
            <div class="price"></div>
        </div>

        <div class="item deposit-entire-flex">
            <div class="item-name">
                <div class="label"></div>
                <div class="qty"></div>
            </div>
            <div class="price"></div>
        </div>

        <div class="item item-deposit total">
            <div class="inner">
                <div class="total-label">Total Due Now</div>
                <div class="total-deposit-price"><span></span>
                @if (!currencyPricing.CurrentCurrencyIsAUD)
                {
                    <br/>
                    <div class="price-aud">
                        (AUD <span></span>)
                    </div>
                }
                    </div>
            </div>

            <div class="terms"></div>
        </div>
    </div>
    <div class="booking-summary-section">

        <div class="action non-agent">
            <a href="/booking/checkout" class="button ui white proceed-button">Proceed</a>
            <a href="#" class="cancel">Cancel</a>
        </div>

    </div>
</div>
</div>
</div>