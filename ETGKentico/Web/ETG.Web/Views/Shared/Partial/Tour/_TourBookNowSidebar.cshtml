            <div class="sub-label"></div>
            <a href="#" class="edit-step js-edit">Change</a>
        </div>
    </div>
    <div class="step-content">
        <div class="ui form" data-method="POST" data-endpoint="/api/booking/submitfreedomofchoice" data-validate-inline="data-validate-inline" data-validate-on="submit">
            <div class="field radio-buttons">
                <input type="hidden" data-validate="checkboxGroup1" data-rules="checkboxCount[1]" data-prompts="Please select an option"/>
                <div class="field">
                    <div class="ui radio checkbox selectnow">
                        <input type="radio" class="show-dynamic-fields" name="freedomofchoice" value="selectnow" @Html.DisableAttrubute(BookNowStepsDetails.StepFreedomOfChoice.DisableSelectNow) @(BookNowStepsDetails.StepFreedomOfChoice.FreedomOfChoiceSelectNow == null || !BookNowStepsDetails.StepFreedomOfChoice.FreedomOfChoiceSelectNow.Value ? "" : "checked")/>
                        <label>Select Now</label>
                    </div>
                </div>
                <div class="field">
                    <div class="ui radio checkbox selectlater">
                        <input type="radio" class="show-dynamic-fields" name="freedomofchoice" value="selectlater" @(BookNowStepsDetails.StepFreedomOfChoice.FreedomOfChoiceSelectNow == null || BookNowStepsDetails.StepFreedomOfChoice.FreedomOfChoiceSelectNow.Value ? "" : "checked")/>
                        <label>Select Later</label>
                    </div>
                </div>
            </div>
            <div class="select-later-copy" @Html.DisplayBlockStyle(!(BookNowStepsDetails.StepFreedomOfChoice.FreedomOfChoiceSelectNow == null || BookNowStepsDetails.StepFreedomOfChoice.FreedomOfChoiceSelectNow.Value))>
                Freedom of Choice options need to be confirmed within the next 2 weeks.
            </div>
            <div class="multiple-room-copy" @Html.DisplayBlockStyle(BookNowStepsDetails.StepFreedomOfChoice.DisableSelectNow)>
                As multiple rooms have been selected, our team will contact you to discuss the Freedom of Choice options.
            </div>
            <div class="option-set-container" @Html.Raw(BookNowStepsDetails.StepFreedomOfChoice.FreedomOfChoiceSelectNow == null || !BookNowStepsDetails.StepFreedomOfChoice.FreedomOfChoiceSelectNow.Value ? "" : " style=\"display:block\"")>
                @if (!Model.BookingFreedomOfChoices.IsNullOrEmpty())
                {
                    var index = 0;
                    foreach (var freedom in Model.BookingFreedomOfChoices)
                    {
                        <div class="option-set field">
                            <div class="option-label">@freedom.DayLabel</div>

                            <div class="field radio-buttons">
                                <input type="hidden" data-validate="@(index++)" data-rules="checkboxCountVisible[1]" data-prompts="Please select an option">

                                @foreach (var option in freedom.Options)
                                {
                                    <div class="field">
                                        <div class="ui radio checkbox">
                                            <input type="radio" name="@freedom.DayName" value="@freedom.DayLabel|@option.Value" @(BookNowStepsDetails.StepFreedomOfChoice.IsSelected(freedom.DayLabel, option.Value)) tabindex="0" class="hidden">
                                            <label>@option.Value</label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }

            </div>

            <div class="submit-row">
                <button type="button" class="ui button primary submit transparent">Next</button>
                <a href="#" class="cancel">Cancel</a>
            </div>
        </div>
    </div>
</div>
