@using Castle.Core.Internal
@using CMS.Core
@using ETG.Booking.Pricing.Services
@using ETG.Core.Extensions;
@using ETG.Data.Extensions
@using ETG.Data.Tour
@model (ETG.Web.Tour.Models.TourListingViewModel Tours, string Heading, string SectionId)
@{
    var currencyPricing = new CurrentCurrencyPricing(DependencyResolver.Current.GetService<ICurrencyService>());
}
@if (Model.Tours == null || Model.Tours.Tours == null)
{
    return;
}
@{
    var tours = Model.Tours.Tours.Where(x => x != null).OrderBy(x => x.FromPrice == null ? 0 : x.FromPrice.LowestPrice);
}

@if (!String.IsNullOrWhiteSpace(Model.SectionId))
{
    <div class="relative">
        <div class="anchor-section top-[-200px] absolute" id="@Model.SectionId"></div>
    </div>
}
<div class="tour-tiles-collection">
    <div class="wrapper">
        @if (!Model.Heading.IsNullOrEmpty())
        {

            <h2 class="text-center uppercase text-black">@Model.Heading</h2>
        }
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 mt-12 gap-x-6 gap-y-12">
            @foreach (var tour in tours)
            {
                var carouselAstroProp = string.Empty;

                if (!tour.Images.IsNullOrEmpty())
                {
                    carouselAstroProp = $"[0,&quot;" + string.Join("&quot;],[0,&quot;", tour.Images.Select(a => a.ImagePath.Imgixify())) + "&quot;]";
                }
                <div class="package-tile flex flex-col group relative hover:shadow-2xl rounded-2xl transition-all duration-300">
                    @if (currencyPricing.CurrencyAppliesDiscounts && tour.Promotion != null)
                    {
                        <div class="promotion bg-[#333] text-white rounded-full py-2 absolute top-0 max-w-[95%] left-1/2 -translate-x-1/2 -translate-y-1/2 z-20 leading-none text-center px-4 text-xs uppercase overflow-hidden text-ellipsis whitespace-nowrap">@Html.Raw(tour.Promotion.PromotionName)</div>
                    }
                    else if (tour.Discount != null && tour.Discount.DisplayAsLabel && !string.IsNullOrWhiteSpace(tour.Discount.DisplayLabel))
                    {
                        <div class="promotion bg-[#333] text-white rounded-full py-2 absolute top-0 max-w-[95%] left-1/2 -translate-x-1/2 -translate-y-1/2 z-20 leading-none text-center px-4 text-xs uppercase overflow-hidden text-ellipsis whitespace-nowrap">@Html.Raw(tour.Discount.DisplayLabel)</div>
                    }
                    <div class="flex flex-col rounded-2xl border border-gray-200 h-full">
                        <span class="image-container aspect-video relative rounded-t-2xl overflow-hidden z-10">
                            <astro-island uid="Z1tHp4q" component-url="/scripts/PackageTileThumbnail.js" component-export="default" renderer-url="/scripts/client.js" props="{&quot;images&quot;:[1,[@Html.Raw(carouselAstroProp)]]}" ssr client="only" opts="{&quot;name&quot;:&quot;PackageTileThumbnail&quot;,&quot;value&quot;:&quot;vue&quot;}"></astro-island>
                        </span>
                        <a href="@tour.Path" class="flex flex-col relative z-20 text-body hover:no-underline flex-1">
                            <span class="content p-6 relative group-hover:bg-gray-100 transition-colors duration-300 flex-1">
                                <span class="badges absolute flex flex-row gap-3 right-6 top-0 -translate-y-1/2">
                                    @if (tour.HasPeaceOfMindGuarantee)
                                    {
                                        <span class="badge rounded-full w-9 h-9 flex items-center justify-center bg-white group/badge relative">
                                            <svg width="21" height="21" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg"> <path d="M12.25 7.0625V5.96875C11.1172 4.52344 10.375 2.84375 10.1016 1.04688C10.0234 0.539062 9.35938 0.304688 9.04688 0.734375C8.1875 1.71094 7.5625 2.84375 7.13281 4.13281C8.46094 5.61719 10.2578 6.63281 12.25 7.0625ZM16.625 3C14.8672 3 13.5 4.40625 13.5 6.16406V8.46875C9.4375 8.23438 5.96094 5.73438 4.39844 2.14062C4.16406 1.67188 3.46094 1.63281 3.26562 2.10156C2.60156 3.46875 2.25 5.03125 2.25 6.63281C2.25 9.40625 3.57812 11.9844 5.57031 13.8984C6.07812 14.4062 6.58594 14.7969 7.09375 15.1875L1.46875 16.5938C1.03906 16.6719 0.84375 17.1797 1.07812 17.5312C1.78125 18.5859 3.46094 20.3828 7.05469 20.5C7.36719 20.5391 7.67969 20.4219 7.91406 20.2266L10.4922 18L13.5 18.0391C16.9375 18.0391 19.75 15.2266 19.75 11.7891V5.5L20.9609 3H16.625ZM16.625 6.78906C16.2734 6.78906 15.9609 6.47656 15.9609 6.16406C15.9609 5.8125 16.2734 5.53906 16.625 5.53906C16.9375 5.53906 17.2109 5.8125 17.2109 6.16406C17.25 6.47656 16.9375 6.78906 16.625 6.78906Z" fill="#929497"></path> </svg> <span class="tooltip absolute transition-opacity bottom-full -translate-y-1 left-1/2 -translate-x-1/2 opacity-0 group-hover/badge:opacity-100 whitespace-nowrap bg-gray-200 text-xs font-bold leading-none rounded p-1">
                                                Peace of mind
                                            </span>
                                        </span>
                                    }
                                    @if (tour.TourHasFreedomOfChoice)
                                    {
                                        <span class="badge rounded-full w-9 h-9 flex items-center justify-center bg-white group/badge relative">
                                            <svg width="18" height="19" viewBox="0 0 18 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M2.125 0.75H7.94531C8.60938 0.75 9.23438 1.02344 9.70312 1.49219L16.5781 8.36719C17.5547 9.34375 17.5547 10.9453 16.5781 11.9219L11.3828 17.1172C10.4062 18.0938 8.80469 18.0938 7.82812 17.1172L0.953125 10.2422C0.484375 9.77344 0.25 9.14844 0.25 8.48438V2.625C0.25 1.60938 1.07031 0.75 2.125 0.75ZM4.625 6.375C5.28906 6.375 5.875 5.82812 5.875 5.125C5.875 4.46094 5.28906 3.875 4.625 3.875C3.92188 3.875 3.375 4.46094 3.375 5.125C3.375 5.82812 3.92188 6.375 4.625 6.375Z" fill="#929497" />
                                                Freedom of Choice
                                            </svg>
                                        </span>

                                    }
                                    @if (tour.TourIsExclusive)
                                    {
                                        <span class="badge rounded-full w-9 h-9 flex items-center justify-center bg-white group/badge relative">
                                            <svg width="22" height="20" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M16.2422 0.125H5.71484L11 6.61328L16.2422 0.125ZM22 7L17.3594 0.941406L12.418 7H22ZM4.59766 0.941406L0 7H9.53906L4.59766 0.941406ZM10.4844 19.1602C10.6133 19.332 10.7852 19.375 11 19.375C11.1719 19.375 11.3438 19.332 11.4727 19.1602L21.9141 8.375H0.0429688L10.4844 19.1602Z" fill="#929497"></path>
                                                Exclusive Packages
                                            </svg>
                                        </span>
                                    }

                                    @if (tour.TourHasSafeTravel)
                                    {
                                        <span class="badge rounded-full w-9 h-9 flex items-center justify-center bg-white group/badge relative">
                                            <svg width="10" height="23" viewBox="0 0 10 23" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M6.95553 6.67116C6.92369 4.46295 5.55426 3.10609 3.40139 3.15265C1.27401 3.19921 -0.0444663 4.64253 0.000119689 6.8707C0.0447057 8.99244 1.54789 10.4823 3.57974 10.4225C5.65617 10.3626 6.98738 8.87937 6.94916 6.67116H6.95553Z" fill="#8CC53F" />
                                                <path d="M0.930176 19.6079L1.53527 18.5437C3.08941 15.83 4.88559 13.2759 6.56712 10.642C8.31234 7.90835 8.49705 5.76665 7.18495 3.91095C5.87285 2.04195 4.25502 1.64953 0.981131 2.46763C0.974762 1.98209 0.974762 0.385791 0.974762 0.385791C0.968392 0.385791 1.42699 0.1663 2.38877 0.0665317C5.08941 -0.252728 7.33782 0.525468 8.87922 2.92657C10.4079 5.30771 10.2678 7.81523 9.08304 10.3094C8.87922 10.7418 8.5926 11.1342 8.33145 11.5399C5.99387 15.1715 3.30597 19.3618 0.968392 22.9934L0.930176 19.6012V19.6079Z" fill="#929497" />
                                                <path d="M6.95553 6.67116C6.98738 8.87937 5.66254 10.3626 3.58611 10.4225C1.54789 10.4823 0.0447057 8.99244 0.000119717 6.8707C-0.0444663 4.64253 1.27401 3.19921 3.39502 3.15265C5.54789 3.10609 6.91732 4.46295 6.94916 6.67116H6.95553Z" fill="#929497" />
                                                Sustainable Travel
                                            </svg>
                                        </span>

                                    }
                                </span>
                                <span class="uppercase text-xs font-black">@tour.DisplayedCountryNames</span>
                                <span class="block mt-2 text-2xl text-primary font-bold">@tour.Name</span>
                                @if (string.IsNullOrWhiteSpace(tour.TourTravelEnds) || tour.TourDepartsFromInAustralia.Equals(tour.TourTravelEnds, StringComparison.InvariantCultureIgnoreCase))
                                {
                                    <span class="block mt-3 text-xs uppercase">Starts and ends in <b class="font-black">@(tour.TourDepartsFromInAustralia)</b></span>
                                }
                                else
                                {
                                    <span class="block mt-3 text-xs uppercase"> <b class="font-black">@(tour.TourDepartsFromInAustralia)</b> to <b class="font-black">@(tour.TourTravelEnds)</b></span>

                                }

                                <span class="mt-3 line-clamp-4">
                                    @Html.Raw(tour.Summary)
                                </span>
                            </span>
                            <span class="footer flex rounded-b-2xl overflow-hidden">
                                <span class="days bg-gray-100 flex items-center p-6 pr-3 flex-1">
                                    <span class="block">
                                        <span class="text-2xl">@(tour.NoOfNights + 1) days</span>
                                        @if (!tour.PriceInclusionIcons.IsNullOrEmpty())
                                        {

                                            <div class="inclusions flex gap-3 mt-2">
                                                @foreach (var icon in tour.PriceInclusionIcons)
                                                {
                                                    <span class="inclusion group/inclusion relative">
                                                        @Html.Raw(icon.SVGCode)
                                                        <span class="tooltip absolute transition-opacity bottom-full -translate-y-1 left-1/2 -translate-x-1/2 opacity-0 group-hover/inclusion:opacity-100 whitespace-nowrap bg-gray-200 text-xs font-bold leading-none rounded p-1">
                                                            @icon.Name
                                                        </span>
                                                    </span>
                                                }
                                            </div>
                                        }
                                        @if (tour.FromPrice != null && currencyPricing.CurrencyAppliesDiscounts && tour.Promotion != null)
                                        {
                                            <span class="pill rounded-full px-4 py-1 text-sm bg-primary text-white font-black mt-4 uppercase inline-block">Save @($"{currencyPricing.CurrentCurrencySymbol}{currencyPricing.ConvertAUDToCurrentCurrency(tour.Promotion.GetDiscount(tour.FromPrice.LowestPrice, 1))}")</span>
                                        }
                                    </span>
                                </span>
                                @if (tour.FromPrice != null)
                                {

                                    <span class="bg-primary shrink-0 pricing flex items-center justify-end p-6 pl-3 text-white flex-1">
                                        <span class="flex flex-col items-end gap-1">
                                            @if (!currencyPricing.CurrencyAppliesDiscounts || tour.Promotion == null)
                                            {
                                                <span class="text-xs">From</span>
                                            }
                                            else
                                            {
                                                <span class="text-sm">
                                                    From
                                                    @if (currencyPricing.CurrencyAppliesDiscounts && tour.Promotion != null)
                                                    {
                                                        <span class="line-through opacity-50">@tour.FromPrice.GetDisplayPriceForCurrentCurrency()</span>
                                                    }

                                                </span>
                                            }

                                            <span class="price flex items-start">
                                                <span class="text-xs uppercase mt-1 mr-1">@tour.FromPrice.Currency</span>
                                                @if (!currencyPricing.CurrencyAppliesDiscounts || tour.Promotion == null)
                                                {

                                                    <span class="text-4xl font-bold">@tour.FromPrice.GetDisplayedPriceNoCurrencyForCurrentCurrency()</span>
                                                }
                                                else
                                                {
                                                    <span class="text-4xl font-bold">@currencyPricing.ConvertAUDToCurrentCurrency(tour.Promotion.GetDiscountedPrice(tour.FromPrice.LowestPrice)).ToString("#,###")</span>
                                                }
                                            </span>
                                            <span class="text-xs">@tour.PriceTypeLabelFormatted</span>
                                        </span>
                                    </span>
                                }
                            </span>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
    @if (!Model.Tours.HideViewAllButton)
    {
        <div class="cta mt-12 text-center"> <a href="@(Model.Tours.ViewAllUrl.IsNullOrEmpty() ? "/search" : Model.Tours.ViewAllUrl.Replace(" ", "%20").Replace("&", "%26"))" class="btn btn-primary-outline">@(Model.Tours.ViewAllButtonLabel.IsNullOrEmpty() ? "View all" : Model.Tours.ViewAllButtonLabel)</a> </div>

    }

</div>


