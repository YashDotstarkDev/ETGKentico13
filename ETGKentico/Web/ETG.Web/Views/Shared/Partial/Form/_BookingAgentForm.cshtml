@using Castle.Core.Internal
@model (ETG.Web.Models.Forms.BookingAgentFormViewModel AgentForm, ETG.Web.Tour.Models.TourViewModel Tour)

<div class="travel-agent-form js-agent-form" @Html.Raw(Model.AgentForm != null && !Model.AgentForm.AgentAgencyName.IsNullOrEmpty() ? "style=\"display:block\"" : "style=\"display:none\"")>
     <div class="ui form" data-method="POST" data-endpoint="/api/booking/submittravelagentdetails" data-validate-inline="data-validate-inline" data-validate-on="submit">

        <div class="field">
            <label>Travel Agency - Trading Name</label>
            <input type="text" name="agencyName" data-rules="empty" data-prompts="Please enter agency name" placeholder="Full name agency" class="agencyname" value="@(Model.AgentForm != null ? Model.AgentForm.AgentAgencyName : "")" />
        </div>

        <div class="field">
            <label>Travel Agency - Postcode</label>
             <input type="text" name="agencyPostcode" data-rules="empty" data-prompts="Please enter postcode" placeholder="Postcode of agency" class="agencypostcode" value="@(Model.AgentForm != null ? Model.AgentForm.AgentPostcode : "")" />
           
        </div>
        <div class="field">
            <label>Travel Agency - Phone Number</label>
            @*<label class="with-tooltip">
            <div>Travel Agency - Phone Number</div>
            <div class="ui tool-tip" data-html="<b>Australian Number</b><br><i>Area Code + Number</i><br>e.g. 0290943322<br><b>Australian Mobile</b><br><i>10 digits no spaces</i><br>e.g. 0430123123<br><b>International Number</b><br><i>Country Code + area code + number</i><br>e.g. +33148643543">
                <svg width="14" height="15" viewBox="0 0 14 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7 0.96875C3.25391 0.96875 0.21875 4.03125 0.21875 7.75C0.21875 11.4961 3.25391 14.5312 7 14.5312C10.7188 14.5312 13.7812 11.4961 13.7812 7.75C13.7812 4.03125 10.7188 0.96875 7 0.96875ZM7 13.2188C3.96484 13.2188 1.53125 10.7852 1.53125 7.75C1.53125 4.74219 3.96484 2.28125 7 2.28125C10.0078 2.28125 12.4688 4.74219 12.4688 7.75C12.4688 10.7852 10.0078 13.2188 7 13.2188ZM7 3.97656C6.34375 3.97656 5.85156 4.49609 5.85156 5.125C5.85156 5.78125 6.34375 6.27344 7 6.27344C7.62891 6.27344 8.14844 5.78125 8.14844 5.125C8.14844 4.49609 7.62891 3.97656 7 3.97656ZM8.53125 10.9219V10.2656C8.53125 10.1016 8.36719 9.9375 8.20312 9.9375H7.875V7.20312C7.875 7.03906 7.71094 6.875 7.54688 6.875H5.79688C5.60547 6.875 5.46875 7.03906 5.46875 7.20312V7.85938C5.46875 8.05078 5.60547 8.1875 5.79688 8.1875H6.125V9.9375H5.79688C5.60547 9.9375 5.46875 10.1016 5.46875 10.2656V10.9219C5.46875 11.1133 5.60547 11.25 5.79688 11.25H8.20312C8.36719 11.25 8.53125 11.1133 8.53125 10.9219Z" fill="#ffffff"/>
                </svg>
            </div>
        </label>*@
            <input type="text" name="agencyPhone" placeholder="Phone number of agency" maxlength="14" class="agencyphone" value="@(Model.AgentForm != null ? Model.AgentForm.AgentPhone : "")" />
        </div>

        <div class="field">
            <label>Travel Advisor - Full Name</label>
            <input type="text" name="agentName" data-rules="empty" data-prompts="Please enter name" placeholder="Full name of consultant" value="@(Model.AgentForm != null ? Model.AgentForm.AgentConsultantName : "")" />
        </div>

        <div class="field">
            <label>Travel Advisor - Email</label>
            <input type="text" name="agentEmail" data-rules="empty,email" data-prompts="Please enter email" placeholder="Email of consultant" value="@(Model.AgentForm != null ? Model.AgentForm.AgentEmail : "")"/>
        </div>
         <div class="action">
             <input type="hidden" name="sessionId" value="@System.Web.HttpContext.Current.Session.SessionID" />
             <input type="hidden" name="tourCode" value="@Model.Tour.TourSummaryInfo.TourCode" />
             <input type="hidden" name="skuId" value="@Model.Tour.SkuId" />
             <input type="hidden" name="tourDays" value="@(Model.Tour.TourSummaryInfo.NoOfNights + 1)" />
             <div @Html.Raw(Model.AgentForm != null && !Model.AgentForm.AgentAgencyName.IsNullOrEmpty() ? "style=\"display:none\"" : "")>
                 <a href="/pdf/@Model.Tour.TourSummaryInfo.TourCode" class="button ui primary outline fluid" target="_blank">Download itinerary</a>
                 <a href="#" class="button ui primary outline fluid ta-client-quote-button" data-url="/booking/quote">Create client quote</a>
                 <a href="#" class="button ui primary fluid ta-book-now-button" data-url="/booking/checkout">Book now</a>
             </div>
             <a href="#" class="cancel">Cancel</a>
         </div>
    </div>
</div>
