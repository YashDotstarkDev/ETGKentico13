@using Castle.Core.Internal
@model ETG.Web.Models.Common.ProofPointComponentViewModel

<div class="experience-bar relative z-20">
    <div class="wrapper">
        <div class="heading flex justify-center">
            <h2 class="bg-white px-7 py-4 text-black -mt-8 rounded-3xl uppercase text-center mx-6 w-[280px] md:w-auto">When experience matters</h2>
        </div>
        <div class="experience-links text-xs mx-auto max-w-[400px] md:max-w-[600px] xl:max-w-none uppercase font-black flex flex-wrap mt-6 justify-center">
            @foreach (var proof in Model.ProofPoints)
            {
                <div class="flex flex-col w-1/2 md:w-1/3 xl:w-[16.6%] p-3 text-center gap-2 items-center hover:no-underline text-body transition-colors duration-300">
                    @Html.Raw(proof.SvgIcon)
                    @proof.Label
                </div>
            }
        </div>
    </div>
</div>