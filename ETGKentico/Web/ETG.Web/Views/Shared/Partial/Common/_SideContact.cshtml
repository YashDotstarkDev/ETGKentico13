@using Castle.Core.Internal
@using ETG.Core.Extensions
@model ETG.Web.Models.Common.GenericSideContactViewModel

@if (Model == null || Model.GeneralContact == null)
{
    return;
}
<div class="widget generic-enquire-side sticky" data-widget="generic-enquire-side">
    <div class="logo">
        <img class="lazyload" data-src="@("/images/etg.png".Imgixify())" alt="Entire Travel Group">
    </div>
    <div class="brand-details">
        <div class="title">Entire Travel Group</div>
        @if (!Model.GeneralContact.PhoneNumber.IsNullOrEmpty())
        {
            <div class="line">
                <span class="icon fas fa-phone"></span>@Model.GeneralContact.PhoneNumber
            </div>
        }
        @if (!Model.GeneralContact.PhoneNumber2.IsNullOrEmpty())
        {
            <div class="line">
                <span class="icon fas fa-phone"></span>@Model.GeneralContact.PhoneNumber2
            </div>
        }
        @if (!Model.GeneralContact.DisplayAddress.IsNullOrEmpty())
        {
            <div class="line">
                <span class="icon fas fa-envelope"></span>@Html.Raw(Model.GeneralContact.DisplayAddress.Replace("\n", "<br>"))
            </div>
        }
    </div>
    <div class="contact">
        @if (Model.DestinationExpertContacts.IsNullOrEmpty())
        {
            @Html.Partial("Partial/Form/_SideButtons")
        }
        else
        {
            <div class="title">Or speak to a Destination Expert</div>
            <p>@Model.GeneralContact.DestinationExpertInstruction</p>

            <p class="label">Destination</p>
            <select class="make-dropdown" name="destination">
                <option value="">Please select</option>
                @foreach (var expert in Model.DestinationExpertContacts)
                {
                    <option value="@expert.Name">@expert.Name</option>
                }
            </select>
            <div class="data-set" data-value="" data-phone="@Model.GeneralContact.PhoneNumber" data-url="/destination-experts"></div>
            foreach (var expert in Model.DestinationExpertContacts)
            {
                <div class="data-set" data-value="@expert.Name" data-phone="@expert.Phone" data-url="@expert.Url"></div>
            }

            <div class="lines">
                <div class="line">
                    <span class="icon fas fa-phone"></span><span class="number">@Model.GeneralContact.PhoneNumber</span>
                </div>
                <a href="/destination-experts" class="line"><span class="icon fas fa-users"></span>Meet our teams</a>
            </div>
        }
    </div>
</div>