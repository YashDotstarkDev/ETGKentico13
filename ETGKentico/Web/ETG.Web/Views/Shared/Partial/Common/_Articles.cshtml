@using Castle.Core.Internal
@using ETG.Core.Extensions
@model ETG.Web.Article.Models.ArticleListingViewModel

@if (Model == null || Model.Articles.IsNullOrEmpty())
{
    return;
}

<div class="blog-carousel">
    <div class="wrapper">
        <h2 class="text-black text-center uppercase">@Model.Title</h2>
        <div class="prose text-body text-lg md:text-xl text-center mt-6 mx-auto max-w-5xl text-balance">
            @Html.Raw(Model.Description)
        </div>
        <div class="flex flex-wrap -mx-4 justify-center mt-8">
            @foreach (var article in Model.Articles)
            {
                <div class="tile p-4 w-full md:w-1/2 xl:w-1/4">
                    <a href="@article.Url.ToLower()" class="block hover:no-underline relative text-body group">
                        <span class="block image-container w-full h-[180px] relative rounded-md overflow-hidden isolate">
                            <img data-lowsrc="@article.HeroImage.ImgixifyLowRes()" data-src="@article.HeroImage.Imgixify(280, 160, true)" data-sizes="auto" class="lazyload absolute z-0 inset-0 w-full h-full object-cover group-hover:scale-105 transition-all duration-300" alt="@article.Title">
                        </span>
                        <span class="flex flex-col justify-end gap-2 py-4 relative z-20">
                            <span class="text-xs font-bold uppercase">@article.FirstDestinationName</span>
                            <span class="text-lg text-primary group-hover:text-body transition-colors duration-300 font-normal">@article.Title</span>
                        </span>
                    </a>
                </div>
            }

        </div>
        <div class="cta mt-8 flex justify-center"> <a href="@Model.ViewAllUrl" class="btn btn-primary-outline">View all</a></div>
    </div>
</div>
<div class="spacer"></div>