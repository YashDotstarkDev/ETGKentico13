@using System.Web.Mvc.Html
@using Castle.Core.Internal
@using ETG.Core.Extensions
@using Microsoft.Ajax.Utilities
@model (ETG.Web.Models.Common.PageHeroViewModel Hero, string Heading, string Summary)

@if (Model.Hero == null || Model.Heading.IsNullOrEmpty())
{
    return;
}

@{
    var imageUrl = string.Empty;
    var imageCaption = string.Empty;
    if (!Model.Hero.GalleryImages.IsNullOrEmpty())
    {
        var firstImage = Model.Hero.GalleryImages.FirstOrDefault();
        imageUrl = firstImage.ImagePath;
        imageCaption = firstImage.ImageCaption;
    }
    else
    {
        imageUrl = Model.Hero.HeroImage;
        imageCaption = Model.Hero.HeroCaption;
    }
}


<div class="new-hero">
    <div class="wrapper-large">
        <div class="outer-container relative">
            <div class="image-container overflow-hidden relative rounded-3xl aspect-video md:aspect-auto md:h-[420px] flex items-center justify-center p-6">
                <img data-lowsrc="@imageUrl.ImgixifyLowRes()" data-src="@imageUrl.Imgixify(0, 0)" data-sizes="auto" class="lazyload absolute z-0 inset-0 w-full h-full object-cover opacity-80" alt="Hilton Moorea Lagoon Resort & Spa"> <!-- Optional overlay - add this instead of using class background-darker-->
                @if (!Model.Hero.DisableOverlay)
                {
                    <div class="overlay absolute z-10 inset-0 bg-black/25"></div>
                }
                <div class="location absolute z-20 top-4 left-4 text-white text-xs items-center justify-start gap-2 flex text-left">
                    <svg width="9" height="13" viewBox="0 0 9 13" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
                        <path d="M6.375 5C6.375 6.05469 5.53125 6.875 4.5 6.875C3.44531 6.875 2.625 6.05469 2.625 5C2.625 3.96875 3.44531 3.125 4.5 3.125C5.53125 3.125 6.375 3.96875 6.375 5ZM4.5 4.25C4.07812 4.25 3.75 4.60156 3.75 5C3.75 5.42188 4.07812 5.75 4.5 5.75C4.89844 5.75 5.25 5.42188 5.25 5C5.25 4.60156 4.89844 4.25 4.5 4.25ZM9 5C9 7.0625 6.25781 10.6953 5.03906 12.2188C4.75781 12.5703 4.21875 12.5703 3.9375 12.2188C2.71875 10.6953 0 7.0625 0 5C0 2.51562 1.99219 0.5 4.5 0.5C6.98438 0.5 9 2.51562 9 5ZM4.5 1.625C2.625 1.625 1.125 3.14844 1.125 5C1.125 5.30469 1.21875 5.75 1.47656 6.35938C1.71094 6.92188 2.0625 7.57812 2.46094 8.23438C3.14062 9.3125 3.91406 10.3438 4.5 11.0938C5.0625 10.3438 5.83594 9.3125 6.51562 8.23438C6.91406 7.57812 7.26562 6.92188 7.5 6.35938C7.75781 5.75 7.875 5.30469 7.875 5C7.875 3.14844 6.35156 1.625 4.5 1.625Z" fill="white"></path>
                    </svg>
                    @Html.Raw(imageCaption)
                </div>
                @{
                    if (!string.IsNullOrEmpty(Model.Hero.HeroForegroundImage))
                    {
                        <div class="foreground-image z-20 absolute inset-10 inset-y-12 md:inset-16">
                            <img src="@Model.Hero.HeroForegroundImage.Imgixify(0,0, false, false)" class="object-contain absolute w-full h-full left-0 top-0">
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(Model.Hero.CampaignTitle))
                    {
                        <div class="foreground relative z-20 text-white">
                            <div class="title font-headings font-bold uppercase text-center text-balance leading-tight">
                                <div class="h1">@Html.Raw(Model.Hero.CampaignTitle)</div>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="share-container absolute right-8 bottom-0 translate-y-1/2 z-20"> <astro-island uid="2hTCIV" component-url="/scripts/ShareButton.js" component-export="default" renderer-url="/scripts/client.js" props="{&quot;url&quot;:[0,&quot;https://url.to.share&quot;],&quot;title&quot;:[0,&quot;Title to share&quot;],&quot;text&quot;:[0,&quot;Text to share&quot;]}" ssr client="only" opts="{&quot;name&quot;:&quot;ShareButton&quot;,&quot;value&quot;:&quot;vue&quot;}"></astro-island> </div>
        </div>
        @if (!Model.Heading.IsNullOrEmpty() || !Model.Summary.IsNullOrEmpty())
        {
            <div class="w-full max-w-4xl mx-auto mt-12 md:mt-20">
                <div class="mt-12 uppercase text-primary">
                    <h1 class="h2">@Model.Heading</h1>
                </div>
                @if (!Model.Summary.IsNullOrEmpty())
                {
                    <div class="mt-8 text-intro">
                        @Html.Raw(Model.Summary)
                    </div>
                }
            </div>

        }
    </div>
</div> 