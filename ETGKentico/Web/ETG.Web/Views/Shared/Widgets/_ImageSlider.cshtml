@using Castle.Core.Internal
@using Kentico.PageBuilder.Web.Mvc
@using Kentico.Web.Mvc
@using ETG.Web.Models.Widgets.IconsContent
@using ETG.Web.Helpers
@using ETG.Core.Extensions;
@model List<ETG.Web.Models.Common.ImageViewModel>

@if (Model.IsNullOrEmpty())
{
    return;
}

<div class="widget photo-slider" data-widget="photo-slider">
    <div class="wrapper">
        <div class="slider">

            @foreach (var image in Model)
            {
                <div class="item">
                    <div class="inner">
                        <img class="lazyload" data-src="@image.ImagePath.Imgixify()" alt="">
                    </div>
                </div>
            }
        </div>
    </div>
</div>