@using Kentico.PageBuilder.Web.Mvc
@using ETG.Web.Models.Widgets.YoutubeVideo
@using ETG.Core.Extensions;
@using Castle.Core.Internal
@using Kentico.PageBuilder.Web.Mvc
@using ETG.Web.Helpers
@model ComponentViewModel<YoutubeVideoProperties>

@{
    var youtubeId = Model.Properties.YoutubeID;
    if (youtubeId.IsNullOrEmpty())
    {
        return;
    }
    var index = youtubeId.IndexOf("v=");
    if (index > -1)
    {
        youtubeId = youtubeId.Substring(index + 2);
    }
}

@if (!Model.Properties.OpenInNewWindow)
{
    <div class="widget static-video wp" data-widget="static-video">
        <div class="inner-container">
            <div class="video-container">
                <div class="video-button">
                    @if (!Model.Properties.Image.IsNullOrEmpty())
                    {
                        var imageViewModel = MediaFileHelper.GetImageMediaFile(Model.Properties.Image[0].FileGuid);
                        if (imageViewModel != null)
                        {
                            <img class="lazyload" data-src="@imageViewModel.ImagePath.Imgixify()" alt="@Model.Properties.Caption">

                        }
                    }
                    <span class="tint"></span>
                    <span class="play"><i class="fas fa-play"></i></span>
                    <span class="copy">@Model.Properties.Caption</span>
                </div>
                <iframe src="https://www.youtube.com/embed/@youtubeId" width="420" height="315" title="" frameborder="0"></iframe>
            </div>
        </div>
    </div>
}
else
{
    
    <div class="widget video wp" data-widget="video">
        <div class="video-container">
            <a href="https://www.youtube.com/watch?v=@youtubeId" class="video-button">
                @if (!Model.Properties.Image.IsNullOrEmpty())
                {
                    var imageViewModel = MediaFileHelper.GetImageMediaFile(Model.Properties.Image[0].FileGuid);
                    if (imageViewModel != null)
                    {
                        <img class="lazyload" data-src="@imageViewModel.ImagePath.Imgixify()" alt="@Model.Properties.Caption">

                    }
                }
                <span class="tint"></span>
                <span class="play"><i class="fas fa-play"></i></span>
                <span class="copy">@Model.Properties.Caption</span>
            </a>
        </div>
    </div>
}