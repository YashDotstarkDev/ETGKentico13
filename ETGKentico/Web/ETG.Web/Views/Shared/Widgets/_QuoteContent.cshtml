@using Kentico.PageBuilder.Web.Mvc
@using ETG.Web.Models.Widgets.QuoteContent
@using ETG.Core.Extensions;
@model ComponentViewModel<QuoteContentProperties>
@if (Model.Properties.HasSidePadding)
{
    @Html.Raw("<div class=\"wrapper\">")
}
<div class="quote">
    <div class="copy">@Model.Properties.TextContent</div>
    <div class="author">@Model.Properties.Source</div>
    <div class="speech">
        <img class="lazyload" data-src="@("/images/quote-marks.png".Imgixify())" alt="">
    </div>
</div>

@if (Model.Properties.HasSidePadding)
{
    @Html.Raw("</div>")
}