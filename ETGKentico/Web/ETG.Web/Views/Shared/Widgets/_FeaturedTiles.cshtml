@using Castle.Core.Internal
@using Kentico.PageBuilder.Web.Mvc
@using Kentico.Web.Mvc
@using ETG.Web.Models.Widgets.IconsContent
@using ETG.Web.Helpers
@using ETG.Core.Extensions;
@model ETG.Web.Models.Widgets.FeaturedTilesWidget.FeaturedTilesWidgetViewModel

@if (Model.Ctas.IsNullOrEmpty())
{
    return;
}

@if (!String.IsNullOrWhiteSpace(Model.SectionId))
{
    <div class="relative">
        <div class="anchor-section top-[-200px] absolute" id="@Model.SectionId"></div>
    </div>
}
<div class="featured-tiles">
    <div class="wrapper">
        <h2 class="text-center text-black uppercase">@Html.Raw(Model.Heading)</h2>
        <div class="-m-4 mt-6 flex flex-wrap justify-center">
            @foreach (var tile in Model.Ctas)
            {
                <div class="tile p-4 w-full md:w-1/2 xl:w-1/4">

                    @if (Model.TileType == 1)
                    {
                        <div class="group block hover:no-underline relative rounded-md overflow-hidden isolate text-white bg-black">
                            <span class="background-image image-container absolute inset-0 z-0">
                                <img data-lowsrc="@tile.ImagePath.ImgixifyLowRes()" data-src="@tile.ImagePath.Imgixify()" data-sizes="auto" class="lazyload absolute z-0 inset-0 w-full h-full object-cover group-hover:scale-105 transition-all duration-300" alt="@tile.Caption">
                            </span>
                            <span class="foreground flex flex-col justify-end gap-4 p-10 relative z-20 h-[400px]"> <span class="text-2xl font-bold">@tile.Caption</span> <span>@Html.Raw(tile.SubCaption)</span> </span>
                        </div>
                    }
                    else
                    {
                        <a href="@tile.Url" class="group block hover:no-underline relative rounded-md overflow-hidden isolate text-white bg-black">
                            <span class="background-image image-container absolute inset-0 z-0">
                                <img data-lowsrc="@tile.ImagePath.ImgixifyLowRes()" data-src="@tile.ImagePath.Imgixify()" data-sizes="auto" class="lazyload absolute z-0 inset-0 w-full h-full object-cover group-hover:scale-105 transition-all duration-300" alt="@tile.Caption">
                            </span>
                            <span class="foreground flex flex-col justify-end gap-4 p-10 relative z-20 h-[400px]">
                                <span class="uppercase text-2xl font-bold">@tile.Caption</span> <span>@Html.Raw(tile.SubCaption)</span>
                                @if (!tile.CtaLabel.IsNullOrEmpty())
                                {
                                    <span class="cta btn mt-4 bg-primary group-hover:bg-black">@tile.CtaLabel</span>
                                }
                            </span>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>
