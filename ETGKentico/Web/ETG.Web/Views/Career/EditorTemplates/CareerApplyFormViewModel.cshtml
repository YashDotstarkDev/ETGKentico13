@using Castle.Core.Internal
@using ETG.Core.Extensions
@model ETG.Web.Career.Models.CareerApplyFormViewModel
<div class="gr-10">
    <div class="gc-12-12 gc-768-6-12 gc-1024-6-12">
        <div class="field">
            <label>First name</label>
            @Html.TextBoxFor(m => m.FirstName, new
            {
                data_rules = "regExp[/[aeiou]/]",
                data_prompts = "Please enter a valid first name"
            })
        </div>
    </div>
    <div class="gc-12-12 gc-768-6-12 gc-1024-6-12">
        <div class="field">
            <label>Last name</label>
            @Html.TextBoxFor(m => m.LastName, new
            {
                data_rules = "regExp[/[aeiou]/]",
                data_prompts = "Please enter a valid last name"
            })
        </div>
    </div>
</div>
<div class="gr-10">
    <div class="gc-12-12 gc-768-6-12 gc-1024-6-12">
        <div class="field">
            <label>Email</label>
            @Html.TextBoxFor(m => m.Email, new
            {
                data_rules = "empty,email",
                data_prompts = ""
            })
        </div>
    </div>
    <div class="gc-12-12 gc-768-6-12 gc-1024-6-12">
        <div class="field">
            <label>Phone</label>
            @Html.TextBoxFor(m => m.Phone, new
            {
                data_rules = "numberVisible",
                data_prompts = ""
            })
        </div>
    </div>
</div>
<div class="gr-10">
    <div class="gc-12-12 gc-768-6-12 gc-1024-6-12">
        <div class="field">
            <label>Preferred contact method</label>
            <div class="grouped fields">
                <input type="hidden" data-validate="checkboxGroup1" data-rules="checkboxCount[1]" data-prompts="You must select at least one" />
                <div class="field">
                    <div class="ui radio checkbox">
                        @Html.RadioButtonFor(m => m.PreferredContactType, "email", new { name = "preferredContact", @checked = "checked" })
                        <label>Email</label>
                    </div>
                </div>
                <div class="field">
                    <div class="ui radio checkbox">
                        @Html.RadioButtonFor(m => m.PreferredContactType, "phone", new { name = "preferredContact" })
                        <label>Phone</label>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="widget filepicker" data-widget="filepicker">
    <div class="field">
        <div class="file-picker">
            <div class="trigger">
                <button type="button" class="ui primary button">Attach CV</button>
            </div>
            @Html.TextBoxFor(m => m.CVFile, new { type = "file", id = "files", name = "files", data_rules = "empty", data_prompts = "Please choose a file", accept = ".doc, .pdf, .docx" })
            <div class="file-list"></div>
            <input type="hidden" data-rules="empty" data-prompts="Please choose a file" name="file-json" class="file-json">
        </div>
    </div>
</div>

<div class="field">
    <label>Questions or comments</label>
    @Html.TextAreaFor(m => m.Message, new
    {
        placeholder = "optional"
    })
</div>
@Html.Partial("Partial/Form/_Recaptcha")
@Html.HiddenFor(m => m.Role)

@Html.HiddenFor(m => m.PageAlias)