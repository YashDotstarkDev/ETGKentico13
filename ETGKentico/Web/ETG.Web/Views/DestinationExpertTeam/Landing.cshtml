@using Castle.Core.Internal
@using ETG.Core.Extensions
@using ETG.Web.Helpers

@model ETG.Web.DestinationExpertTeam.Models.DestinationExpertTeamLandingPageViewModel

@{
    Layout = "~/Views/Shared/_Master.cshtml";
}

@if (Model?.Page == null)
{
    return;
}

@section HeadMeta {
    @Html.Partial("Partial/MasterPage/_MetaTags", Model.Page.Page)
    @if (Context.Kentico().PageBuilder().EditMode)
    {
        @Html.Kentico().PageBuilderStyles()
    }
}

@section AdditionalScripts {
    @Html.ScriptTag("/scripts/destination-experts.js")
    @if (Context.Kentico().PageBuilder().EditMode)
    {
        @Html.Kentico().PageBuilderScripts()
    }
}

@section TopBreadcrumbs {
    @Html.Partial("Partial/Common/_BreadCrumbs", Model)
}

<div class="widget destination-expert-listing" data-widget="destination-expert-listing">
    <div class="top">
        <div class="wrapper">
            <h1>@Model.Page.PageHero.Heading</h1>
            <p>@Html.Raw(Model.Page.PageHero.HeadingSummary)</p>
        </div>
    </div>

    <div class="bottom wp">
        <div class="wrapper">
            @if (!Model.DestinationExperts.IsNullOrEmpty())
            {
                <div class="teams">
                    @foreach (var item in Model.DestinationExperts)
                    {
                        <a href="@item.Url" class="item">
                            <div class="inner">
                                <img class="lazyload" data-src="@item.HeroImage.Imgixify()" alt="@item.Name">
                                <div class="gradient"></div>
                                <div class="title">
                                    <div class="label">Team</div>
                                    @item.Name
                                </div>
                            </div>
                            <div class="overlay">
                                <div class="title">@item.Name</div>
                                <div class="copy">@item.SummaryText</div>
                            </div>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>