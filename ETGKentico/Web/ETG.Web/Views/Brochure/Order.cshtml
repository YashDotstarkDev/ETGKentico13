@using Castle.Core.Internal
@using ETG.Core.Extensions
@using ETG.Web.Helpers

@model ETG.Web.Brochure.Models.BrochureOrderPageViewModel

@{
    Layout = "~/Views/Shared/_Master.cshtml";
}

@if (Model?.Page == null)
{
    return;
}

@section HeadMeta {
    @Html.Partial("Partial/MasterPage/_MetaTags", Model.Page.Page)
}

@section AdditionalScripts {
    @Html.ScriptTag("/scripts/contact-us.js")
    <script src="https://www.google.com/recaptcha/api.js?render=@ViewBag.RecaptchaSiteKey"></script>
}

@section TopBreadcrumbs {
    @Html.Partial("Partial/Common/_BreadCrumbs", Model)
}

<div class="top">
    <div class="wrapper">
        @if (Model.Page.PageHero != null)
        {
            <h1>@Model.Page.PageHero.Heading</h1>
        }
    </div>
</div>

<div class="wrapper wp">
    <div class="article-layout">
        <div class="main">
            @Html.Raw(Model.Page.Content)
            <div id="brochureOrder" class="ui form generic-form" data-validate-inline="data-validate-inline" data-validate-on="submit" data-method="POST" data-endpoint="@Url.Action("Order", "Brochure")">
                <div class="response-container"></div>
                @if (Model.Form != null && !Model.Form.ErrorMessage.IsNullOrEmpty())
                {
                    <div class="field">
                        <div class="ui basic red pointing prompt label">
                            @Html.Raw(Model.Form.ErrorMessage)
                        </div>
                    </div>
                }
                
                    @Html.AntiForgeryToken()
                    @Html.EditorFor(m => m.Form)
                    <div class="response-container"></div>

                    <div class="submit-row">
                        <button class="ui button submit primary">Submit</button>
                    </div>
                
            </div>
        </div>

        <div class="side">
            <div class=" side-email-order">
                <div class="title">
                    <div class="icon fas fa-envelope"></div>
                    Email order
                </div>
                @if (Model.Form != null && Model.Form != null && !Model.Form.BrochureOrders.IsNullOrEmpty())
                {
                    <div class="brochures">
                        @foreach (var brochure in Model.Form.BrochureOrders)
                        {
                            <div class="item">
                                <div class="image">
                                    <img class="lazyload" data-src="@brochure.CoverImage.Imgixify()" alt="@brochure.Name">
                                </div>
                                <div class="name">@brochure.Name</div>
                            </div>
                        }
                    </div>
                }

                <form action="/brochures" method="post" class="ui form generic-form">
                    <input type="hidden" class="added-brochures" name="brochures" value="@(Model.Form != null ? Model.Form.BrochureGuids : "")">

                    <div class="submit-row">
                        <button class="ui button submit primary small transparent">Add more brochures</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>