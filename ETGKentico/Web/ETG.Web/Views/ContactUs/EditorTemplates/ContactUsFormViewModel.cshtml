@using Castle.Core.Internal
@using ETG.Core.Extensions
@model ETG.Web.Models.Forms.ContactUsFormViewModel

@Html.TextBoxFor(m => m.Friend, new { style = "display:none" })

<div class="gr-10">
    <div class="gc-12-12 gc-768-6-12 gc-1024-6-12">
        <div class="field">
            <label>First name</label>
            @Html.TextBoxFor(m => m.FirstName, new
            {
                data_rules = "regExp[/[aeiou]/]",
                data_prompts = "Please enter a valid first name"
            })
        </div>
    </div>
    <div class="gc-12-12 gc-768-6-12 gc-1024-6-12">
        <div class="field">
            <label>Last name</label>
            @Html.TextBoxFor(m => m.LastName, new
            {
                data_rules = "regExp[/[aeiou]/]",
                data_prompts = "Please enter a valid last name"
            })
        </div>
    </div>
</div>
<div class="gr-10">
    <div class="gc-12-12 gc-768-6-12 gc-1024-6-12">
        <div class="field">
            <label>Email</label>
            @Html.TextBoxFor(m => m.Email, new
            {
                data_rules = "emailDependOnRadio[Form.PreferredContactType|email]",
                data_prompts = ""
            })
        </div>
    </div>
    <div class="gc-12-12 gc-768-6-12 gc-1024-6-12">
        <div class="field">
            <label>Phone</label>
            @Html.TextBoxFor(m => m.Phone, new
            {
                data_rules = "phoneDependOnRadio[Form.PreferredContactType|phone]",
                data_prompts = "Please enter only numbers in this field."
            })
        </div>
    </div>
</div>
<div class="gr-10">
    <div class="gc-12-12 gc-768-6-12 gc-1024-6-12">
        <div class="field">
            <label>Preferred contact method</label>
            <div class="grouped fields">
                <input type="hidden" data-validate="checkboxGroup1" data-rules="checkboxCount[1]" data-prompts="You must select at least one"/>
                <div class="field">
                    <div class="ui radio checkbox">
                        @Html.RadioButtonFor(m => m.PreferredContactType, "email", new { name = "preferredContact", @checked = "checked" })
                        <label>Email</label>
                    </div>
                </div>
                <div class="field">
                    <div class="ui radio checkbox">
                        @Html.RadioButtonFor(m => m.PreferredContactType, "phone", new { name = "preferredContact" })
                        <label>Phone</label>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="field">
    <label>Questions or comments</label>
    @Html.TextAreaFor(m => m.Message, new
    {
        data_rules = "empty",
        data_prompts = "",
        rows = 8
    })
</div>
<div class="field">
    <div class="ui checkbox">
        @*@Html.CheckBoxFor(m => m.SubscribeToNewsletter)*@
        <input type="checkbox" name="Form.SubscribeToNewsletter" value="true" />
        <label>Subscribe to our newsletter for special deals.</label>
    </div>
</div>
@Html.Partial("Partial/Form/_Recaptcha")