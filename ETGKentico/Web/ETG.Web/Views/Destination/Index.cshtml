@using Castle.Core.Internal
@using ETG.Web.Helpers
@using Microsoft.Ajax.Utilities
@using PayPal.Api

@model ETG.Web.Destination.Models.DestinationPageViewModel

@{
    Layout = "~/Views/Shared/_Master.cshtml";
}

@if (Model?.Destination == null)
{
    return;
}

@section HeadMeta {
    @Html.Partial("Partial/MasterPage/_MetaTags", Model.Destination)
    @if (Context.Kentico().PageBuilder().EditMode)
    {
        @Html.Kentico().PageBuilderStyles()
    }

    <script type="application/ld+json">
    @Html.Raw(Model.Destination.JsonSchema)
    </script>
}

@section AdditionalScripts {
    @Html.ScriptTag("/scripts/new-destination.js")
    <!-- Calendly badge widget begin -->
    <link href=https://assets.calendly.com/assets/external/widget.css rel="stylesheet">
    <script src=https://assets.calendly.com/assets/external/widget.js type="text/javascript" async></script>
    <!-- Calendly badge widget end -->
    @if (Context.Kentico().PageBuilder().EditMode)
    {
        @Html.Kentico().PageBuilderScripts()
    }
}

@Html.Partial("Partial/Destination/_CampaignSticky", Model.DestinationStickyModel)

@Html.Partial("Partial/Common/_BreadCrumbs", Model)


@Html.Partial("Partial/Common/_PageHeroWithOverview", (Model.Hero, Model.Destination.BasicInfo.Heading, Model.Destination.BasicInfo.Summary))
<div class="spacer small"></div>

@if (!Model.QuickLinkItems.IsNullOrEmpty())
{
    <div class="anchor-navigation sticky top-[99px] transition-all duration-500 z-[500]">
        <div class="transition-all duration-500 [.stuck_&]:bg-gray-200 overflow-hidden">
            <div class="wrapper">
                <div class="max-w-4xl w-full mx-auto">
                    <div class="rounded-2xl bg-gray-200 px-6 overflow-hidden relative [.stuck_&]:overflow-visible">
                        <div class="relative z-10">
                            <astro-island uid="ZzoyL8" component-url="/scripts/AnchorCarousel.js" component-export="default" renderer-url="/scripts/client.js" props="{&quot;center-insufficient-slides&quot;:[0,true]}" ssr client="only" opts="{&quot;name&quot;:&quot;AnchorCarousel&quot;,&quot;value&quot;:&quot;vue&quot;}" await-children>
                                <template data-astro-template>
                                    <div class="swiper isolate text-left !overflow-visible text-sm font-semibold">
                                        <div class="swiper-wrapper">
                                            @foreach (var slide in Model.QuickLinkItems)
                                            {
                                                <div class="swiper-slide !w-auto px-4"><button class="py-6" data-section="@slide.SectionIdName"><span class="label py-1 border-b-2 border-transparent [.active_&]:border-primary hover:border-primary">@slide.Heading</span></button></div>
                                            }
                                        </div>
                                    </div>
                                </template><!--astro:end-->
                            </astro-island>
                        </div>
                        <div class="absolute z-20 inset-y-0 left-0 w-12 bg-gradient-to-l from-gray-200/0 to-gray-200 pointer-events-none [.stuck_&]:hidden"></div>
                        <div class="absolute z-20 inset-y-0 right-0 w-12 bg-gradient-to-r from-gray-200/0 to-gray-200 pointer-events-none [.stuck_&]:hidden"></div>
                    </div>
                </div>
            </div>
        </div>
        <astro-island uid="ZQNzks" component-url="/scripts/AnchorNavigationController.js" component-export="default" renderer-url="/scripts/client.js" props="{}" ssr client="only" opts="{&quot;name&quot;:&quot;AnchorNavigationController&quot;,&quot;value&quot;:&quot;vue&quot;}"></astro-island>
    </div>
    <div class="spacer"></div>
}

<div class="relative">
    <div class="anchor-section top-[-200px] absolute" id="section_overview"></div>
</div>
@if (!Model.Destination.Detail.IsNullOrEmpty())
{
    <div class="wrapper">
        <div class="max-w-4xl mx-auto w-full">
            <div class="prose text-sm text-body max-w-none">
                @Html.Raw(Model.Destination.Detail)
            </div>
        </div>
    </div>
    <div class="spacer"></div>
}
@if (!Model.Destination.SVGMap.IsNullOrEmpty() && !Model.MainDestinationMapItems.IsNullOrEmpty())
{
    <div class="widget svg-map" data-widget="svg-map">
        <div class="wrapper">
            <h3>Regions</h3>
            <div class="map">
                @Html.Raw(Model.Destination.SVGMap)

                <div class="list">
                    @foreach (var mapItem in Model.MainDestinationMapItems)
                    {
                        <a href="@mapItem.RegionUrl" class="region" data-region-id="@mapItem.ID">@mapItem.RegionName</a>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    if (!Model.RegionMapItems.IsNullOrEmpty())
    {
        @Html.Partial("Partial/Common/_Map", Model.RegionMapItems)
        <div class="spacer"></div>
    }
}

@if (Model.DestinationExpert != null)
{
    @Html.Partial("Partial/Common/_PreferredSpeakingPhone", Model.DestinationExpert)
    <div class="spacer"></div>
}


@if (Model.FeatureTours != null && !Model.FeatureTours.Tours.IsNullOrEmpty())
{

    <div class="spacer"></div>
    <div class="relative">
        <div class="anchor-section top-[-200px] absolute" id="section_packages"></div>
    </div>
    @Html.Partial("Partial/Tour/_TourListing", (Model.FeatureTours, $"Popular {Model.Destination.BasicInfo.Name} Packages", string.Empty))
}

@Html.Kentico().EditableArea("Zone1")


@if (Model.FeatureTilesComponent != null)
{
    <div class="spacer"></div>
    <div class="relative">
        <div class="anchor-section top-[-200px] absolute" id="section_featured"></div>
    </div>
    @Html.Partial("Partial/Common/_FeatureTiles", Model.FeatureTilesComponent)

}

@if (!Model.HelpfulInformation.IsNullOrEmpty() || !Model.Destination.WhenToVisit.IsNullOrEmpty())
{
    <div class="spacer"></div>
    <div class="relative">
        <div class="anchor-section top-[-200px] absolute" id="section_info"></div>
    </div>
    <div class="max-w-5xl mx-auto w-full">
        <div class="package-accordion">
            <div class="heading flex items-end justify-between">
                <h2 class="text-black uppercase">Helpful Information</h2>
            </div>
            <astro-island uid="1h6eF5" component-url="/scripts/FAQs.js" component-export="default" renderer-url="/scripts/client.js" props="{}" ssr client="only" opts="{&quot;name&quot;:&quot;FAQs&quot;,&quot;value&quot;:&quot;vue&quot;}" await-children>
                <template data-astro-template>
                    <div class="border-b border-black/10 mt-8">
                        @if (!Model.Destination.WhenToVisit.IsNullOrEmpty())
                        {
                            <div class="item border-t border-black/10 transition-all duration-500">
                                <div class="question hover:bg-gray-100 transition-all duration-300 pl-6 py-4 flex items-center justify-between cursor-pointer gap-8 text-lg md:text-xl">
                                    When to visit
                                    <div class="icon text-primary w-6 h-6 shrink-0 flex items-center justify-center mr-4 transition-transform duration-500 text-xl [.active_&]:rotate-180"> <i class="fas fa-chevron-down"></i> </div>
                                </div>
                                <div class="answer pl-6 prose font-normal text-body text-sm max-w-none pr-12 grid grid-rows-[0fr] [.active_&]:grid-rows-[1fr] transition-all duration-300">
                                    <div class="overflow-hidden isolate">
                                        <div class="pb-12 pt-4">
                                            @Html.Raw(Model.Destination.WhenToVisit)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        @foreach (var info in Model.HelpfulInformation)
                        {
                            <div class="item border-t border-black/10 transition-all duration-500">
                                <div class="question hover:bg-gray-100 transition-all duration-300 pl-6 py-4 flex items-center justify-between cursor-pointer gap-8 text-lg md:text-xl">
                                    @info.Heading
                                    <div class="icon text-primary w-6 h-6 shrink-0 flex items-center justify-center mr-4 transition-transform duration-500 text-xl [.active_&]:rotate-180"> <i class="fas fa-chevron-down"></i> </div>
                                </div>
                                <div class="answer pl-6 prose font-normal text-body text-sm max-w-none pr-12 grid grid-rows-[0fr] [.active_&]:grid-rows-[1fr] transition-all duration-300">
                                    <div class="overflow-hidden isolate">
                                        <div class="pb-12 pt-4">
                                            @Html.Raw(info.Contents)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }


                    </div>
                </template>
            </astro-island>
        </div>
    </div>
    <div class="spacer"></div>
}

@Html.Kentico().EditableArea("Zone2")

<div class="relative">
    <div class="anchor-section top-[-200px] absolute" id="section_contact_us"></div>
</div>
<div class="scroll-section">
    <div class="wrapper">
        @Html.Partial("Partial/Tour/_TourConnectWithUs", Model.ConnectWithUs)
    </div>
</div>
<div class="spacer"></div>

@if (!Model.RelatedArticles.IsNullOrEmpty())
{
    <div class="relative">
        <div class="anchor-section top-[-200px] absolute" id="section_blogs"></div>
    </div>
    <div class="blog-carousel">
        <div class="wrapper">
            @if (!string.IsNullOrWhiteSpace(Model.Destination.RelatedArticlesHeader))
            {
                <h2 class="text-black text-center uppercase">@Model.Destination.RelatedArticlesHeader</h2>
            }
            else
            {
                <h2 class="text-black text-center uppercase">Read what we've written on @Model.Destination.BasicInfo.Heading</h2>
            }
            @Html.Partial("Partial/Article/_RelatedArticles", Model.RelatedArticles)
            <div class="widget view-all-cta" data-widget="view-all-cta">
                <a href="/articles" class="ui button primary transparent">View all</a>
            </div>
        </div>
    </div>
}

@Html.Action("GetNonPackageSticky", "NonPackageSticky")