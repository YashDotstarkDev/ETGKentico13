<rules>
	<rule name="Redirect to HTTPS WWW" enabled="true" stopProcessing="true">
		<match url="(.*)" />
		<conditions logicalGrouping="MatchAny" trackAllCaptures="false">
			<add input="{HTTPS}" pattern="off" />
			<add input="{HTTP_HOST}" pattern="^[^www]" />
		</conditions>
		<action type="Redirect" url="https://www.entiretravel.com.au/{R:0}" />
	</rule>
	<rule name="rule" enabled="true" stopProcessing="true">
		<match url="(.*)" />
		<conditions>
			<add input="{URL}" pattern="[A-Z]" ignoreCase="false" />
			<add input="{URL}" pattern="etg/media/*" negate="true" />
			<add input="{URL}" pattern="getmedia/*" negate="true" />
			<add input="{URL}" pattern="/cmsctx/*" negate="true"/>
			<add input="{URL}" pattern="/kentico*" negate="true" />
			<add input="{URL}" pattern="_child-action-only/*" negate="true" />
		</conditions>
		<action type="Redirect" url="{ToLower:{URL}}" />
	</rule>
	<rule name="Remove trailing slash" stopProcessing="true">
		<match url="(.*)/$" />
		<conditions>
			<add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
			<add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
			<add input="{URL}" pattern="etg/media/*" negate="true" />
			<add input="{URL}" pattern="getmedia/*" negate="true" />
			<add input="{URL}" pattern="/cmsctx/*" negate="true" />
			<add input="{URL}" pattern="/kentico*" negate="true" />
			<add input="{URL}" pattern="_child-action-only/*" negate="true" />
		</conditions>
		<action type="Redirect" redirectType="Permanent" url="{R:1}" />
	</rule>

	<rule name="RedirectCruisesToCruiseJourneys" patternSyntax="ExactMatch" stopProcessing="true">
		<match url="cruises" ignoreCase="true" />
		<action type="Redirect" url="cruise-journeys" redirectType="Permanent" />
	</rule>

	<rule name="RedirectBargeCruiseArticle" patternSyntax="ExactMatch" stopProcessing="true">
		<match url="articles/8-things-consider-booking-barge-cruise" ignoreCase="true" />
		<action type="Redirect" url="cruises/barge-cruising" redirectType="Permanent" />
	</rule>

	<rule name="RedirectContactUsArticle" patternSyntax="ExactMatch" stopProcessing="true">
		<match url="articles/contact-us" ignoreCase="true" />
		<action type="Redirect" url="contact-us" redirectType="Permanent" />
	</rule>

	<rule name="RedirectCovidTravelCredit" patternSyntax="ExactMatch" stopProcessing="true">
		<match url="covid-19-travel-credit" ignoreCase="true" />
		<action type="Redirect" url="covid-19-travel-credit-policy" redirectType="Permanent" />
