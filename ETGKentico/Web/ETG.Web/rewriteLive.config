	<rule name="RedirectCheckoutToRoot" patternSyntax="ExactMatch" stopProcessing="true">
		<match url="booking/checkout" ignoreCase="true" />
		<action type="Redirect" url="/" redirectType="Permanent" />
	</rule>
	
